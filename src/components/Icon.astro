---
// One icon or tool logo from data/icons.ts, drawn inline so it takes the colour of the text around it.
// Icons are decoration: the words next to them carry the meaning, so they are hidden from screen readers.
// Styles: ".ico" in styles/global.css.
import { icons, logos } from '../data/icons';

interface Props { name: string; size?: number; class?: string }
const { name, size = 20, class: cls } = Astro.props;
const logo = (logos as Record<string, string>)[name];
const body = (icons as Record<string, string>)[name];
if (!logo && !body) throw new Error(`Icon "${name}" is not in src/data/icons.ts`);
---
{logo
  ? <svg class:list={['ico', 'ico-logo', cls]} viewBox="0 0 24 24" width={size} height={size} aria-hidden="true" focusable="false"><path d={logo} /></svg>
  : <svg class:list={['ico', cls]} viewBox="0 0 24 24" width={size} height={size} aria-hidden="true" focusable="false" set:html={body} />}
