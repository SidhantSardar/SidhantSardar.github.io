---
// Pictures for the eight steps of the product design story (pages/work/altrum-product-design.astro).
// Same style as the Work covers (WorkArt.astro): light, real-looking work scenes with real words and the
// people involved, on a calm backdrop. Styles: ".wh" in styles/global.css.
// Sample names and data only; no real screens and no customer data.
//   domain     a research board: who uses the product and what worries them
//   palette    the styles page in Figma: colours, type and the first components
//   layouts    three layouts sharing one navigation
//   flow       the main flow, an edge case, and the sign-off from the team
//   screens    one screen in its four states
//   prototype  the Figma Make prototype, demonstrated on a call
//   check      design next to build, with a flagged gap
//   loop       test notes turning into fixes for the next release
type Kind = 'domain' | 'palette' | 'layouts' | 'flow' | 'screens' | 'prototype' | 'check' | 'loop';
interface Props { kind: Kind }
const { kind } = Astro.props;
const id = `sa-${kind}`;
const sh = `url(#${id}-sh)`;
const sh2 = `url(#${id}-sh2)`;
const skin = ['#E9B78F', '#B9845C', '#8D5A3B', '#D9A27C', '#C68E6A'];
---
<svg class="wa wh sa" viewBox="0 0 400 300" aria-hidden="true" focusable="false">
  <defs>
    <filter id={`${id}-sh`} x="-10%" y="-10%" width="120%" height="130%"><feDropShadow dx="0" dy="6" stdDeviation="7" flood-color="#0B1030" flood-opacity=".2" /></filter>
    <filter id={`${id}-sh2`} x="-20%" y="-20%" width="140%" height="160%"><feDropShadow dx="0" dy="3" stdDeviation="3.5" flood-color="#0B1030" flood-opacity=".22" /></filter>
  </defs>

  {kind === 'domain' && (
    <>
      <g filter={sh}><rect class="wh-win" x="16" y="16" width="368" height="268" rx="10" /></g>
      <text class="wh-b" x="30" y="36">Research board · AI governance</text><text class="wh-s" x="300" y="36">FigJam</text>
      <line class="wh-ln" x1="16" y1="46" x2="384" y2="46" />
      {[['Compliance lead', 'Are we breaking any rule?', '#FFE58F'], ['Risk analyst', 'Which AI is risky?', '#FFC7D9'], ['ML engineer', 'Don’t slow my releases', '#C9F0D2']].map(([who, q, c], i) => (
        <>
          <circle cx={58 + i * 116} cy="70" r="9" fill={skin[i]} />
          <text class="wh-t" x={72 + i * 116} y="68">{who}</text><text class="wh-s" x={72 + i * 116} y="78">{['Approves policies', 'Scores every system', 'Ships the models'][i]}</text>
          <g filter={sh2}><rect x={34 + i * 116} y="92" width="100" height="56" rx="3" fill={c} /></g>
          <text class="wh-hand" x={42 + i * 116} y="112">{q.split(' ').slice(0, 3).join(' ')}</text>
          <text class="wh-hand" x={42 + i * 116} y="126">{q.split(' ').slice(3).join(' ')}</text>
        </>
      ))}
      <path class="wh-arrow" d="M84 152v18c0 14 14 18 116 18M200 152v36M316 152v18c0 14-14 18-116 18" />
      <rect x="132" y="190" width="136" height="26" rx="13" fill="#2E3BFF" /><text class="wh-btn big" x="200" y="207" text-anchor="middle">One place to govern AI</text>
      {['Policies', 'Risk', 'Audits', 'Incidents'].map((t, i) => (
        <><rect class="wh-card" x={52 + i * 76} y="232" width="68" height="34" rx="6" /><text class="wh-t" x={86 + i * 76} y="253" text-anchor="middle">{t}</text></>
      ))}
    </>
  )}

  {kind === 'palette' && (
    <>
      <g filter={sh}><rect class="wh-win" x="16" y="16" width="368" height="268" rx="10" /></g>
      <text class="wh-b" x="30" y="36">Altrum · Foundations</text><text class="wh-s" x="306" y="36">Figma styles</text>
      <line class="wh-ln" x1="16" y1="46" x2="384" y2="46" />
      <text class="wh-th" x="30" y="64">COLOUR</text>
      {[['Primary', '#2E3BFF', 'Accent'], ['Ink', '#14161A', 'Text'], ['Success', '#127A3E', 'Safe'], ['Warning', '#C27A00', 'Review'], ['Danger', '#C4320A', 'High risk']].map(([n, c, u], i) => (
        <>
          <rect x={30 + i * 68} y="72" width="60" height="40" rx="6" fill={c} />
          {i === 0 && <rect x={28 + i * 68} y="70" width="64" height="44" rx="8" fill="none" stroke="#2E3BFF" stroke-width="1.5" />}
          <text class="wh-t" x={30 + i * 68} y="126">{n}</text><text class="wh-s" x={30 + i * 68} y="136">{u}</text>
        </>
      ))}
      <line class="wh-ln" x1="30" y1="150" x2="370" y2="150" />
      <text class="wh-th" x="30" y="168">TYPE</text>
      <text x="30" y="196" class="wh-aa">Aa</text>
      <text class="wh-t" x="80" y="180">Heading · 24 / 32 · Bold</text><text class="wh-t" x="80" y="194">Body · 14 / 20 · Regular</text><text class="wh-s" x="80" y="207">Label · 12 / 16 · Medium</text>
      <line class="wh-ln" x1="30" y1="222" x2="370" y2="222" />
      <text class="wh-th" x="30" y="240">COMPONENTS</text>
      <rect x="30" y="250" width="66" height="20" rx="5" fill="#2E3BFF" /><text class="wh-btn big" x="63" y="263.5" text-anchor="middle">Approve</text>
      <rect class="wh-card" x="104" y="250" width="60" height="20" rx="5" /><text class="wh-t" x="134" y="263.5" text-anchor="middle">Cancel</text>
      <rect x="174" y="254" width="38" height="13" rx="6.5" fill="#FDE4E1" /><text class="wh-pill" x="193" y="263" text-anchor="middle" fill="#B42318">High</text>
      <rect x="218" y="254" width="38" height="13" rx="6.5" fill="#DCF5E6" /><text class="wh-pill" x="237" y="263" text-anchor="middle" fill="#127A3E">Low</text>
      <rect class="wh-card" x="266" y="250" width="104" height="20" rx="5" /><text class="wh-s" x="274" y="263">Search AI systems…</text>
    </>
  )}

  {kind === 'layouts' && (
    <>
      {[['Table · scan a list', 0], ['Dashboard · see the state', 1], ['Split view · read and act', 2]].map(([label, i]) => {
        const x = 16 + +i * 124;
        return (
          <>
            <text class="wh-t wh-out" x={x} y="40">{label}</text>
            <g filter={sh2}><rect class="wh-win" x={x} y="48" width="118" height="168" rx="7" /></g>
            <rect class="wh-side" x={x} y="48" width="28" height="168" />
            <rect x={x + 8} y="56" width="12" height="12" rx="3" fill="#2E3BFF" />
            {[0, 1, 2, 3].map((k) => <rect x={x + 9} y={78 + k * 16} width="10" height="8" rx="2" fill={k === +i ? '#2E3BFF' : '#D5D8E0'} />)}
            {+i === 0 && [0, 1, 2, 3, 4, 5].map((k) => (
              <><rect x={x + 36} y={60 + k * 24} width="44" height="6" rx="3" fill="#D5D8E0" /><rect x={x + 86} y={59 + k * 24} width="22" height="9" rx="4.5" fill={['#FDE4E1', '#DCF5E6', '#FFF1D6'][k % 3]} /><line class="wh-ln" x1={x + 36} y1={74 + k * 24} x2={x + 110} y2={74 + k * 24} /></>
            ))}
            {+i === 1 && (
              <>
                {[0, 1].map((k) => <><rect class="wh-card" x={x + 36 + k * 38} y="58" width="34" height="32" rx="4" /><text class="wh-num sm" x={x + 42 + k * 38} y="82">{['24', '3'][k]}</text></>)}
                <rect class="wh-card" x={x + 36} y="98" width="72" height="62" rx="4" />
                <path d={`M${x + 42} 150l12-10 10 4 12-14 12 6 14-12`} fill="none" stroke="#2E3BFF" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                <rect class="wh-card" x={x + 36} y="168" width="72" height="38" rx="4" />
              </>
            )}
            {+i === 2 && (
              <>
                {[0, 1, 2, 3, 4].map((k) => <rect x={x + 34} y={58 + k * 18} width="30" height="12" rx="3" fill={k === 1 ? '#E8EAFF' : '#EEF0F4'} />)}
                <rect class="wh-card" x={x + 68} y="58" width="44" height="148" rx="4" />
                <rect x={x + 73} y="64" width="30" height="6" rx="3" fill="#14161A" />
                {[0, 1, 2].map((k) => <rect x={x + 73} y={78 + k * 10} width="32" height="4" rx="2" fill="#D5D8E0" />)}
                <rect x={x + 73} y="186" width="34" height="12" rx="3" fill="#2E3BFF" />
              </>
            )}
          </>
        );
      })}
      <rect x="92" y="236" width="216" height="30" rx="15" fill="#FFFFFF" filter={sh2} />
      <rect x="104" y="246" width="10" height="10" rx="3" fill="#2E3BFF" />
      <text class="wh-t" x="122" y="254.5">Same navigation on every screen</text>
    </>
  )}

  {kind === 'flow' && (
    <>
      <g filter={sh}><rect class="wh-win" x="16" y="16" width="368" height="268" rx="10" /></g>
      <text class="wh-b" x="30" y="36">Flow · Add an AI system</text><text class="wh-s" x="290" y="36">Confirmed 12 Mar</text>
      <line class="wh-ln" x1="16" y1="46" x2="384" y2="46" />
      {[['Add system', 30], ['Describe it', 102], ['Risk check', 174], ['Review', 246], ['Approved', 318]].map(([t, x], i) => (
        <>
          <rect x={x} y="78" width="58" height="30" rx="6" fill={i === 4 ? '#127A3E' : i === 0 ? '#2E3BFF' : '#FFFFFF'} stroke={i === 0 || i === 4 ? 'none' : '#D5D8E0'} />
          <text class={i === 0 || i === 4 ? 'wh-btn big' : 'wh-t'} x={+x + 29} y="96.5" text-anchor="middle">{t}</text>
          {i < 4 && <path d={`M${+x + 60} 93h10`} stroke="#2E3BFF" stroke-width="1.6" /> }
          {i < 4 && <path d={`M${+x + 72} 93l-5-3v6z`} fill="#2E3BFF" />}
        </>
      ))}
      {/* edge cases */}
      <path class="wh-arrow" d="M131 110v34h28M203 110v34" />
      <rect x="161" y="134" width="84" height="22" rx="5" fill="#FFF1D6" /><text class="wh-t" x="203" y="148.5" text-anchor="middle">Missing info?</text>
      <text class="wh-s" x="250" y="148.5">→ ask the owner, save draft</text>
      <rect x="161" y="164" width="84" height="22" rx="5" fill="#FDE4E1" /><text class="wh-t" x="203" y="178.5" text-anchor="middle">High risk?</text>
      <text class="wh-s" x="250" y="178.5">→ send to risk team</text>
      <path class="wh-arrow" d="M203 156v8" />
      {/* sign-off */}
      <line class="wh-ln" x1="30" y1="204" x2="370" y2="204" />
      <text class="wh-th" x="30" y="222">SIGNED OFF BEFORE ANY SCREEN IS DESIGNED</text>
      {[['Rahul', 'Team lead'], ['Meera', 'Product'], ['Arjun', 'Developer']].map(([n, r], i) => (
        <>
          <g filter={sh2}><rect class="wh-note" x={30 + i * 116} y="232" width="104" height="36" rx="7" /></g>
          <circle cx={46 + i * 116} cy="250" r="8" fill={skin[i + 1]} />
          <text class="wh-t" x={60 + i * 116} y="248">{n}</text><text class="wh-s" x={60 + i * 116} y="258">{r}</text>
          <circle cx={120 + i * 116} cy="250" r="6" fill="#127A3E" /><path d={`M${117 + i * 116} 250l2 2 4-4`} fill="none" stroke="#fff" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
        </>
      ))}
    </>
  )}

  {kind === 'screens' && (
    <>
      {[['Default', 0], ['Empty', 1], ['Loading', 2], ['Error', 3]].map(([label, i]) => {
        const x = 16 + (+i % 2) * 188, y = 24 + Math.floor(+i / 2) * 138;
        return (
          <>
            <text class="wh-t wh-out" x={x} y={y + 6}>{label}</text>
            <g filter={sh2}><rect class="wh-win" x={x} y={y + 14} width="180" height="108" rx="6" /></g>
            <text class="wh-b" x={x + 10} y={y + 32}>AI systems</text>
            <line class="wh-ln" x1={x} y1={y + 40} x2={x + 180} y2={y + 40} />
            {+i === 0 && [['Loan triage model', 'High', '#FDE4E1', '#B42318'], ['Support chatbot', 'Low', '#DCF5E6', '#127A3E'], ['Fraud alerts', 'Medium', '#FFF1D6', '#9A5B00']].map(([n, r, bg, fg], k) => (
              <><text class="wh-t" x={x + 10} y={y + 58 + k * 20}>{n}</text><rect x={x + 130} y={y + 50 + k * 20} width="38" height="11" rx="5.5" fill={bg} /><text class="wh-pill" x={x + 149} y={y + 58 + k * 20} text-anchor="middle" fill={fg}>{r}</text></>
            ))}
            {+i === 1 && (
              <>
                <circle cx={x + 90} cy={y + 64} r="10" fill="#E8EAFF" /><text class="wh-b" x={x + 90} y={y + 67} text-anchor="middle" fill="#2E3BFF">+</text>
                <text class="wh-t" x={x + 90} y={y + 88} text-anchor="middle">No AI systems yet</text>
                <rect x={x + 60} y={y + 96} width="60" height="15" rx="4" fill="#2E3BFF" /><text class="wh-btn" x={x + 90} y={y + 106} text-anchor="middle">Add your first</text>
              </>
            )}
            {+i === 2 && [0, 1, 2].map((k) => (
              <><rect x={x + 10} y={y + 52 + k * 20} width="90" height="8" rx="4" fill="#EEF0F4" /><rect x={x + 130} y={y + 51 + k * 20} width="38" height="10" rx="5" fill="#EEF0F4" /></>
            ))}
            {+i === 3 && (
              <>
                <rect x={x + 10} y={y + 52} width="160" height="36" rx="5" fill="#FDE4E1" />
                <text class="wh-t" x={x + 20} y={y + 67} fill="#B42318">Couldn’t load your systems</text>
                <text class="wh-s" x={x + 20} y={y + 79}>Check your connection</text>
                <rect class="wh-card" x={x + 10} y={y + 96} width="48" height="15" rx="4" /><text class="wh-t" x={x + 34} y={y + 106} text-anchor="middle">Try again</text>
              </>
            )}
          </>
        );
      })}
    </>
  )}

  {kind === 'prototype' && (
    <>
      <g filter={sh}><rect class="wh-win" x="16" y="16" width="368" height="268" rx="10" fill="#1B1D24" /></g>
      <rect x="16" y="16" width="368" height="268" rx="10" fill="#1B1D24" />
      <text class="wh-b light" x="30" y="36">Demo · Altrum prototype</text>
      <circle cx="356" cy="33" r="4" fill="#E5484D" /><text class="wh-s light" x="312" y="36">Live</text>
      {/* the prototype being shared */}
      <rect x="30" y="48" width="236" height="168" rx="6" fill="#FFFFFF" />
      <rect x="30" y="48" width="236" height="16" rx="6" fill="#F1F2F5" /><text class="wh-u" x="148" y="59" text-anchor="middle">Figma Make · Add an AI system</text>
      <text class="wh-h" x="42" y="86">Describe the system</text>
      <text class="wh-s" x="42" y="98">Step 2 of 4</text>
      {['Name', 'Owner', 'What does it decide?'].map((t, k) => (
        <><text class="wh-s" x="42" y={116 + k * 26}>{t}</text><rect class="wh-card" x="42" y={120 + k * 26} width="150" height="14" rx="3" /></>
      ))}
      <text class="wh-t" x="48" y="130">Loan triage model</text>
      <rect x="196" y="194" width="58" height="15" rx="4" fill="#2E3BFF" /><text class="wh-btn" x="225" y="204" text-anchor="middle">Continue →</text>
      <g class="wh-cur" transform="translate(220 196)"><path d="M0 0 4.3 13 6.7 7.3 12.6 5.3z" fill="#14161A" stroke="#fff" stroke-width="1.2" stroke-linejoin="round" /></g>
      {/* people on the call */}
      {[['Rahul', 'Team lead'], ['Arjun', 'Developer'], ['Neha', 'Developer']].map(([n, r], i) => (
        <>
          <rect x="276" y={48 + i * 58} width="94" height="52" rx="6" fill="#2A2D36" />
          <circle cx="323" cy={68 + i * 58} r="11" fill={skin[i + 1]} />
          <text class="wh-s light" x="282" y={94 + i * 58}>{n} · {r}</text>
        </>
      ))}
      {/* a question from the team */}
      <g filter={sh2}><rect class="wh-note" x="30" y="226" width="236" height="44" rx="7" /></g>
      <circle cx="44" cy="241" r="6" fill={skin[2]} /><text class="wh-b" x="54" y="243.5">Arjun · Developer</text>
      <text class="wh-t" x="40" y="260">Can step 2 save a draft if the owner is unknown?</text>
      <rect x="276" y="232" width="94" height="32" rx="6" fill="#2E3BFF" /><text class="wh-btn big" x="323" y="251" text-anchor="middle">Noted for v2</text>
    </>
  )}

  {kind === 'check' && (
    <>
      {[['Design · Figma', 16], ['Build · staging', 206]].map(([label, x], i) => (
        <>
          <text class="wh-t wh-out" x={x} y="34">{label}</text>
          <g filter={sh2}><rect class="wh-win" x={x} y="42" width="178" height="150" rx="7" /></g>
          <text class="wh-b" x={+x + 12} y="62">AI systems</text>
          <rect x={+x + 120} y="52" width="46" height="15" rx="4" fill="#2E3BFF" /><text class="wh-btn" x={+x + 143} y="62" text-anchor="middle">Add system</text>
          {[['Loan triage model', 'High', '#FDE4E1', '#B42318'], ['Support chatbot', 'Low', '#DCF5E6', '#127A3E'], ['Fraud alerts', 'Medium', '#FFF1D6', '#9A5B00']].map(([n, r, bg, fg], k) => {
            const gap = i === 1 && k === 1 ? 5 : 0;
            return (
              <>
                <line class="wh-ln" x1={+x + 12} y1={78 + k * 22} x2={+x + 166} y2={78 + k * 22} />
                <text class="wh-t" x={+x + 12} y={93 + k * 22 + gap}>{n}</text>
                <rect x={+x + 124} y={85 + k * 22 + gap} width="38" height="11" rx="5.5" fill={bg} /><text class="wh-pill" x={+x + 143} y={93 + k * 22 + gap} text-anchor="middle" fill={fg}>{r}</text>
              </>
            );
          })}
          {i === 1 && <rect x={+x + 6} y="102" width="166" height="24" rx="4" fill="none" stroke="#E5484D" stroke-width="1.5" stroke-dasharray="3 2" />}
          <rect x={+x + 12} y="160" width="70" height="20" rx="4" fill="#EEF0F4" /><text class="wh-s" x={+x + 20} y="173">{i === 0 ? 'Empty state ✓' : 'Empty state —'}</text>
        </>
      ))}
      {/* the review */}
      <g filter={sh2}><rect class="wh-note" x="16" y="206" width="368" height="72" rx="8" /></g>
      <circle cx="32" cy="224" r="7" fill={skin[0]} /><text class="wh-b" x="44" y="226.5">Sidhant · Design review</text><text class="wh-s" x="300" y="226.5">2 gaps found</text>
      <circle cx="36" cy="246" r="4" fill="#E5484D" /><text class="wh-t" x="46" y="249">Row 2 spacing is 13px, design says 8px</text>
      <circle cx="36" cy="264" r="4" fill="#E5484D" /><text class="wh-t" x="46" y="267">Empty state is missing on staging</text>
      <rect x="296" y="252" width="76" height="18" rx="4" fill="#2E3BFF" /><text class="wh-btn big" x="334" y="264.5" text-anchor="middle">Send to dev</text>
    </>
  )}

  {kind === 'loop' && (
    <>
      <g filter={sh}><rect class="wh-win" x="16" y="16" width="230" height="268" rx="10" /></g>
      <text class="wh-b" x="30" y="36">Test notes · v1.4</text><text class="wh-s" x="196" y="36">8 found</text>
      <line class="wh-ln" x1="16" y1="46" x2="246" y2="46" />
      {[['Filters reset after going back', 'Fixed', '#DCF5E6', '#127A3E'], ['Risk score has no explanation', 'Fixed', '#DCF5E6', '#127A3E'], ['Owner field hard to find', 'In v1.5', '#E8EAFF', '#2E3BFF'], ['Long names cut off in table', 'In v1.5', '#E8EAFF', '#2E3BFF'], ['Export takes too many clicks', 'Noted', '#F1F2F5', '#5A5F6E']].map(([n, s, bg, fg], k) => (
        <>
          <circle cx="36" cy={66 + k * 42} r="7" fill={skin[k % 5]} />
          <text class="wh-t" x="50" y={64 + k * 42}>{n}</text>
          <text class="wh-s" x="50" y={75 + k * 42}>{['Flow: review', 'Flow: risk check', 'Flow: add system', 'Screen: AI systems', 'Flow: audit log'][k]}</text>
          <rect x="186" y={58 + k * 42} width="48" height="13" rx="6.5" fill={bg} /><text class="wh-pill" x="210" y={67 + k * 42} text-anchor="middle" fill={fg}>{s}</text>
          {k < 4 && <line class="wh-ln" x1="30" y1={84 + k * 42} x2="234" y2={84 + k * 42} />}
        </>
      ))}
      {/* the loop */}
      <g filter={sh}><rect class="wh-win" x="254" y="30" width="130" height="160" rx="10" /></g>
      <circle cx="318" cy="120" r="52" fill="none" stroke="#D5D8E0" stroke-width="10" />
      <path d="M318 68a52 52 0 0 1 45 78" fill="none" stroke="#2E3BFF" stroke-width="10" stroke-linecap="round" />
      <text class="wh-num" x="318" y="118" text-anchor="middle">v1.5</text><text class="wh-s" x="318" y="131" text-anchor="middle">next release</text>
      {[['Test', 318, 56], ['Note', 380, 158], ['Fix', 256, 158]].map(([t, x, y]) => (
        <><rect x={+x - 20} y={+y - 9} width="40" height="16" rx="8" fill="#FFFFFF" filter={sh2} /><text class="wh-t" x={x} y={+y + 2.5} text-anchor="middle">{t}</text></>
      ))}
      <g filter={sh2}><rect class="wh-note" x="262" y="200" width="122" height="60" rx="8" /></g>
      <text class="wh-s" x="274" y="218">Fixed this release</text>
      <text class="wh-num" x="274" y="243">2 of 8</text>
      <rect x="330" y="232" width="44" height="8" rx="4" fill="#EEF0F4" /><rect x="330" y="232" width="11" height="8" rx="4" fill="#127A3E" />
    </>
  )}
</svg>
