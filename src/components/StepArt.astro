<style is:global>
  /* Step pictures: the few styles they add to the ".wa" family in global.css */
  .wa.sa>text{font-size:9.5px}
  .wa.sa .sa-t{font-family:var(--body);font-size:12px;font-weight:600;letter-spacing:-.005em;fill:var(--ink)}
  .wa.sa .sa-t11{font-size:11px}
  .wa.sa .sa-s{font-family:var(--body);font-size:10px;font-weight:400;letter-spacing:0;fill:var(--muted)}
  .wa.sa .sa-s95{font-size:9.5px}
  .wa.sa .sa-c{font-family:var(--body);font-size:10.5px;font-weight:600;letter-spacing:0;fill:var(--muted)}
  .wa.sa .sa-chip{font-size:8px;fill:var(--muted)}
  .wa.sa .sa-aa{font-family:var(--display);font-size:36px;font-weight:700;letter-spacing:-.04em;fill:var(--ink)}
  .wa.sa .sa-w{fill:#fff}
  .wa.sa .sa-a{fill:var(--accent)}
  .wa .sa-bg{fill:var(--surface)}
  .wa .sa-dimf{fill:var(--dim)}
  .wa .sa-sw{stroke:rgba(128,128,128,.45);stroke-width:1}
  .wa .sa-ring{stroke:var(--surface);stroke-width:2}
  .wa .sa-tick{fill:none;stroke:#fff;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
  .wa .sa-tick-b{fill:none;stroke:var(--accent-fill);stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
  .wa .sa-bang{fill:none;stroke:var(--surface);stroke-width:1.8;stroke-linecap:round}
  .wa .sa-ico{fill:none;stroke:var(--accent);stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}
  .wa .sa-mag{fill:none;stroke:var(--dim);stroke-width:1.4;stroke-linecap:round}
  .wa .sa-dash{fill:none;stroke:var(--dim);stroke-width:1.5;stroke-linecap:round;stroke-dasharray:4 4}
  .wa .sa-dbox{fill:var(--surface);stroke:var(--dim);stroke-width:1.2;stroke-dasharray:4 3}
  .wa .sa-err{fill:var(--surface);stroke:var(--ink);stroke-width:1.2}
  .wa .sa-flag{fill:none;stroke:var(--accent);stroke-width:1.5;stroke-dasharray:4 3}
  /* loading state: the placeholder bars breathe and the spinner turns, once the step is reached */
  .wa .sa-spin{fill:none;stroke:var(--accent);stroke-width:2;stroke-linecap:round;stroke-dasharray:20 12;transform-box:fill-box;transform-origin:center}
  .story-step.on .wa .sa-spin{animation:saSpin 1s linear infinite}
  .story-step.on .wa .sa-skel{animation:saPulse 1.3s ease-in-out infinite}
  @keyframes saSpin{to{transform:rotate(360deg)}}
  @keyframes saPulse{50%{opacity:.35}}
  /* dark theme: the same shapes on black */
  :root[data-theme="dark"] .wa .sa-bg{fill:#15151B}
  :root[data-theme="dark"] .wa .sa-dbox,:root[data-theme="dark"] .wa .sa-err{fill:#15151B}
  :root[data-theme="dark"] .wa .sa-ring{stroke:#0E0E13}
  :root[data-theme="dark"] .wa .sa-flag{stroke:#8F9BFF}
  :root[data-theme="dark"] .wa .sa-tick-b{stroke:#2632F0}
</style>
