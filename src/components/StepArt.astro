---
// Pictures for the eight steps of the product design story (pages/work/altrum-product-design.astro).
// Same family as the Work covers (WorkArt.astro): a corner of a Figma canvas, with named frames, one
// thing selected in blue, blue wires and the designer's cursor. They reuse the ".wa" styles in
// global.css and add a few of their own below (".sa-…"). Every picture is a simplified diagram:
// no real screens and no real data.
//   domain     who uses the product, and what it covers
//   palette    colour, type and the first components
//   layouts    three layouts, one navigation
//   flow       the main path, the edge cases, and the sign-off
//   screens    one screen in its four states
//   prototype  a clickable prototype, shown to the team
//   check      the design next to the build
//   loop       test, note, fix, and the list of observations
type Kind = 'domain' | 'palette' | 'layouts' | 'flow' | 'screens' | 'prototype' | 'check' | 'loop';
interface Props { kind: Kind }
const { kind } = Astro.props;

/** Arrowhead with its tip at x, y, pointing right, left, up or down. */
const arrow = (x: number, y: number, dir: 'r' | 'l' | 'u' | 'd' = 'r') =>
  ({ r: `M${x} ${y}l-9-5.2v10.4z`, l: `M${x} ${y}l9-5.2v10.4z`, u: `M${x} ${y}l-5.2 9h10.4z`, d: `M${x} ${y}l-5.2-9h10.4z` })[dir];
/** A tick, centred on cx, cy. */
const tick = (cx: number, cy: number) => `M${cx - 4.6} ${cy}l3.3 3.3 6-6.6`;
/** Head and shoulders for an avatar centred on cx, cy. */
const person = (cx: number, cy: number) => `M${cx - 5.5} ${cy + 6.6}a5.5 5.2 0 0 1 11 0z`;
/** Four selection handles for a box at x, y with width w and height h. */
const handles = (x: number, y: number, w: number, h: number) =>
  [[x, y], [x + w, y], [x, y + h], [x + w, y + h]].map(([cx, cy]) => ({ x: cx - 3, y: cy - 3 }));

// Per picture: the selected box, where the cursor sits, and where the soft glow goes (dark theme).
const sel: Record<Kind, [number, number, number, number]> = {
  domain: [154, 112, 92, 76], palette: [26, 90, 112, 44], layouts: [272, 52, 114, 148], flow: [302, 74, 78, 38],
  screens: [14, 32, 178, 106], prototype: [14, 48, 112, 148], check: [218, 44, 168, 128], loop: [236, 52, 150, 196],
};
const cur: Record<Kind, [number, number]> = {
  domain: [234, 180], palette: [130, 126], layouts: [338, 186], flow: [268, 230],
  screens: [150, 118], prototype: [104, 180], check: [330, 128], loop: [322, 176],
};
const halo: Record<Kind, [number, number, number, number]> = {
  domain: [200, 150, 150, 115], palette: [82, 112, 150, 105], layouts: [329, 126, 125, 125], flow: [341, 93, 125, 95],
  screens: [103, 85, 155, 105], prototype: [70, 122, 130, 125], check: [302, 108, 145, 115], loop: [118, 150, 135, 125],
};
// How far each picture is nudged up or down so it sits in the middle of its panel.
const vy: Record<Kind, number> = { domain: -9, palette: 0, layouts: 0, flow: 14, screens: -3, prototype: 2, check: -2, loop: -8 };
const glow = `url(#sa-glow-${kind})`;
const [sx, sy, sw, sh] = sel[kind];

const users: [string, number][] = [['Compliance', 80], ['Risk', 150], ['Technical', 220]];
const areas: [string, number, string][] = [
  ['Policies', 60, 'M305 56h8M305 60h8M305 64h5'],
  ['Risk', 120, 'M309 114.5l5.6 9.8h-11.2z'],
  ['Audits', 180, 'M304.4 180l3.2 3.2 6-6.6'],
  ['Incidents', 240, 'M310.6 234.4l-4.6 6.2h4l-1.5 5 4.6-6.2h-4z'],
];
const layoutX = [14, 143, 272];
const states: [string, number, number][] = [['Default', 14, 32], ['Empty', 208, 32], ['Loading', 14, 172], ['Error', 208, 172]];
const checks: [string, number, number, boolean][] = [
  ['Matches the design', 14, 192, true], ['Every state built', 206, 192, true],
  ['Interaction logic works', 14, 234, true], ['Gaps flagged early', 206, 234, false],
];
const notes: [string, string, number, number][] = [['Fixed', 'wa-b', 56, 40], ['Fixed', 'wa-b', 48, 52], ['Next', 'wa-bt', 60, 36], ['Noted', 'wa-g1', 44, 48]];
---
<svg class="wa sa" viewBox={`0 ${vy[kind]} 400 300`} aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id={`sa-halo-${kind}`}><stop offset="0" stop-color="#2E3BFF" stop-opacity=".5" /><stop offset="1" stop-color="#2E3BFF" stop-opacity="0" /></radialGradient>
    <filter id={`sa-glow-${kind}`} filterUnits="userSpaceOnUse" x="0" y="0" width="400" height="300" color-interpolation-filters="sRGB">
      <feGaussianBlur stdDeviation="3" result="b" />
      <feComponentTransfer in="b" result="g"><feFuncA type="linear" slope="2.4" /></feComponentTransfer>
      <feMerge><feMergeNode in="g" /><feMergeNode in="SourceGraphic" /></feMerge>
    </filter>
  </defs>
  <ellipse class="wa-halo" cx={halo[kind][0]} cy={halo[kind][1]} rx={halo[kind][2]} ry={halo[kind][3]} fill={`url(#sa-halo-${kind})`} />

  {kind === 'domain' && (
    <>
      <text x="10" y="56">Who uses it</text>
      <text class="on" x="154" y="104">The product</text>
      <text x="290" y="30">What it covers</text>

      {/* wires: the three teams into the product, the product out to the four areas */}
      <g class="wa-glow" filter={glow}>
        <path class="wa-wire" d="M114 80C132 80 127 150 145 150" />
        <path class="wa-wire" d="M114 150H145" />
        <path class="wa-wire" d="M114 220C132 220 127 150 145 150" />
        <path class="wa-wire" d="M246 150C268 150 259 60 281 60" />
        <path class="wa-wire" d="M246 150C266 150 262 120 281 120" />
        <path class="wa-wire" d="M246 150C266 150 262 180 281 180" />
        <path class="wa-wire" d="M246 150C268 150 259 240 281 240" />
      </g>
      <path class="wa-spark" pathLength="100" d="M114 80C132 80 127 150 145 150" />
      <path class="wa-spark" pathLength="100" d="M114 220C132 220 127 150 145 150" />
      <path class="wa-spark" pathLength="100" style="animation-delay:-1.1s" d="M246 150C268 150 259 60 281 60" />
      <path class="wa-spark" pathLength="100" style="animation-delay:-1.1s" d="M246 150C266 150 262 180 281 180" />
      <path class="wa-b" d={arrow(154, 150)} />
      {areas.map(([, y]) => <path class="wa-b" d={arrow(290, y)} />)}

      {users.map(([t, y]) => (
        <>
          <rect class="wa-cd" x="10.5" y={y - 16} width="104" height="32" rx="16" />
          <circle class="wa-g2" cx="27" cy={y} r="9.5" />
          <circle class="sa-bg" cx="27" cy={y - 2.6} r="3.1" />
          <path class="sa-bg" d={person(27, y)} />
          <text class="sa-t sa-t11" x="43" y={y + 4}>{t}</text>
          <circle class="wa-port" cx="114" cy={y} r="3.6" />
        </>
      ))}

      {/* the product, in the middle */}
      <rect class="wa-b" x="154" y="112" width="92" height="76" rx="14" />
      <path class="wa-w" d="M200 123.5l11 4.4v7.8c0 7.4-4.6 12.4-11 15.2-6.4-2.8-11-7.8-11-15.2v-7.8z" />
      <path class="sa-tick-b" d="M195.2 137.4l3.5 3.5 6.3-6.9" />
      <text class="sa-t sa-w" x="200" y="172" text-anchor="middle">AI governance</text>
      <circle class="wa-port" cx="246" cy="150" r="3.6" />

      {areas.map(([t, y, ico]) => (
        <>
          <rect class="wa-cd" x="290.5" y={y - 19.5} width="99" height="39" rx="8" />
          <rect class="wa-bt" x="299" y={y - 10} width="20" height="20" rx="5" />
          <path class="sa-ico" d={ico} />
          <text class="sa-t sa-t11" x="327" y={y + 4}>{t}</text>
        </>
      ))}
    </>
  )}

  {kind === 'palette' && (
    <>
      <text x="14" y="22">Colour</text>
      <rect class="wa-fr" x="14" y="30" width="228" height="118" rx="10" />
      {['#0A0A0A', '#525252', '#8A8A8A', '#D4D4D4', '#F4F4F4'].map((c, i) => <rect class="sa-sw" x={26 + i * 40} y="44" width="32" height="32" rx="8" fill={c} />)}
      <rect class="wa-b" x="26" y="90" width="112" height="44" rx="9" />
      <text class="sa-t" x="152" y="109">Accent</text>
      <text x="152" y="124">calm · secure</text>

      <text x="256" y="22">Type</text>
      <rect class="wa-fr" x="256" y="30" width="130" height="118" rx="10" />
      <text class="sa-aa" x="267" y="80">Aa</text>
      {([[97, '32', 84, 7], [110, '24', 64, 5.6], [123, '16', 46, 4.6], [136, '13', 36, 3.6]] as [number, string, number, number][]).map(([y, n, w, h], i) => (
        <>
          <text x="268" y={y + 3.2}>{n}</text>
          <rect class={i === 0 ? 'wa-k' : 'wa-g2'} x="290" y={y - h / 2} width={w} height={h} rx={h / 2} />
        </>
      ))}

      <text x="14" y="168">Components</text>
      <rect class="wa-fr" x="14" y="176" width="372" height="110" rx="10" />
      <rect class="wa-b" x="26" y="190" width="88" height="30" rx="8" />
      <text class="sa-t sa-w" x="70" y="209.2" text-anchor="middle">Button</text>
      <rect class="wa-o" x="124.5" y="190.5" width="87" height="29" rx="8" />
      <text class="sa-t" x="168" y="209.2" text-anchor="middle">Button</text>
      <rect class="wa-o" x="222.5" y="190.5" width="151" height="29" rx="8" />
      <circle class="sa-mag" cx="238" cy="204" r="4.2" />
      <path class="sa-mag" d="M241.2 207.2l3.4 3.4" />
      <text class="sa-s" x="251" y="208.6">Search</text>

      <rect class="wa-b" x="26" y="238" width="38" height="22" rx="11" />
      <circle class="wa-w" cx="53" cy="249" r="8" />
      <rect class="wa-g2" x="74" y="238" width="38" height="22" rx="11" />
      <circle class="wa-w" cx="85" cy="249" r="8" />
      <rect class="wa-b" x="126" y="238" width="52" height="22" rx="11" />
      <text class="sa-c sa-w" x="152" y="252.8" text-anchor="middle">High</text>
      <rect class="wa-bt" x="186" y="238" width="66" height="22" rx="11" />
      <text class="sa-c sa-a" x="219" y="252.8" text-anchor="middle">Medium</text>
      <rect class="wa-g1" x="260" y="238" width="48" height="22" rx="11" />
      <text class="sa-c" x="284" y="252.8" text-anchor="middle">Low</text>
      <rect class="wa-b" x="322" y="239" width="20" height="20" rx="5" />
      <path class="sa-tick" d={tick(332, 249)} />
      <circle class="wa-o" cx="364" cy="249" r="9.5" />
      <circle class="wa-b" cx="364" cy="249" r="4.6" />
    </>
  )}

  {kind === 'layouts' && (
    <>
      <text x="14" y="44">Table</text>
      <text x="143" y="44">Dashboard</text>
      <text class="on" x="272" y="44">Split view</text>

      {/* one navigation under all three */}
      <g class="wa-glow" filter={glow}>
        <path class="wa-wire" d="M26 200V224Q26 232 34 232H276Q284 232 284 224V200" />
        <path class="wa-wire" d="M155 200V232" />
      </g>
      <path class="wa-spark" pathLength="100" d="M26 200V224Q26 232 34 232H276Q284 232 284 224V200" />
      <text class="sa-t" x="200" y="259" text-anchor="middle">Same navigation on every screen</text>

      {layoutX.map((x, f) => (
        <>
          <rect class="wa-fr" x={x} y="52" width="114" height="148" rx="6" />
          <rect class="wa-bt" x={x + 0.5} y="52.5" width="24" height="147" rx="5.5" />
          <rect class="wa-b" x={x + 7} y="60" width="10" height="10" rx="2.5" />
          {[80, 92, 104, 116].map((y, i) => <rect class={i === f ? 'wa-b' : 'wa-g2'} x={x + 6} y={y} width="12" height="4" rx="2" />)}
          <circle class="wa-port" cx={x + 12} cy="200" r="3.6" />
        </>
      ))}

      {/* table */}
      <rect class="wa-k" x="46" y="62" width="34" height="6" rx="2" />
      <rect class="wa-b" x="98" y="60" width="22" height="10" rx="3" />
      <rect class="wa-g0" x="44" y="78" width="78" height="12" rx="3" />
      <rect class="wa-bt" x="44" y="125" width="78" height="14" rx="3" />
      {[98, 114, 130, 146, 162, 178].map((y, i) => (
        <>
          <rect class={i === 2 ? 'wa-k' : 'wa-g2'} x="48" y={y} width={[30, 24, 32, 26, 30, 22][i]} height="4" rx="2" />
          <rect class="wa-g1" x="86" y={y} width="12" height="4" rx="2" />
          <rect class={i === 2 ? 'wa-b' : 'wa-g1'} x="104" y={y - 1} width="14" height="6" rx="3" />
        </>
      ))}

      {/* dashboard */}
      <rect class="wa-k" x="175" y="62" width="30" height="6" rx="2" />
      <rect class="wa-b" x="175" y="78" width="22" height="26" rx="4" />
      <rect class="wa-w" x="179" y="84" width="10" height="3" rx="1.5" opacity=".7" />
      <rect class="wa-w" x="179" y="92" width="14" height="6" rx="1.5" />
      {[201, 227].map((x) => (
        <>
          <rect class="wa-cd" x={x + 0.5} y="78.5" width="21" height="25" rx="4" />
          <rect class="wa-g2" x={x + 4} y="84" width="10" height="3" rx="1.5" />
          <rect class="wa-k" x={x + 4} y="92" width="12" height="6" rx="1.5" />
        </>
      ))}
      <rect class="wa-cd" x="175.5" y="112.5" width="73" height="50" rx="4" />
      <path class="wa-ln" d="M181 130.5h62M181 142.5h62" />
      <path class="wa-bt" d="M181 152 191 146 201 149 211 138 221 141 231 130 243 134V157H181z" />
      <path class="wa-line" d="M181 152 191 146 201 149 211 138 221 141 231 130 243 134" />
      <rect class="wa-cd" x="175.5" y="170.5" width="73" height="22" rx="4" />
      <circle class="wa-b" cx="184" cy="181.5" r="2.5" />
      <rect class="wa-g2" x="191" y="179.5" width="36" height="4" rx="2" />

      {/* split view */}
      <rect class="wa-k" x="304" y="62" width="28" height="6" rx="2" />
      {[78, 102, 126, 150, 174].map((y, i) => (
        <>
          <rect class={i === 1 ? 'wa-bo' : 'wa-cd'} x="304.5" y={y + 0.5} width="29" height="19" rx="3.5" />
          <rect class={i === 1 ? 'wa-b' : 'wa-g2'} x="308" y={y + 5.5} width="16" height="3.5" rx="1.75" />
          <rect class="wa-g1" x="308" y={y + 11.5} width="21" height="3" rx="1.5" />
        </>
      ))}
      <rect class="wa-cd" x="340.5" y="78.5" width="37" height="115" rx="4" />
      <rect class="wa-k" x="345" y="85" width="22" height="5" rx="1.5" />
      {[[96, 28], [103, 24], [110, 18]].map(([y, w]) => <rect class="wa-g2" x="345" y={y} width={w} height="3.5" rx="1.75" />)}
      <rect class="wa-g1" x="345" y="120" width="28" height="34" rx="3" />
      <rect class="wa-g2" x="345" y="161" width="26" height="3.5" rx="1.75" />
      <rect class="wa-b" x="345" y="176" width="28" height="11" rx="3" />
    </>
  )}

  {kind === 'flow' && (
    <>
      <text class="on" x="14" y="62">Main path</text>
      <text x="14" y="181">Edge cases</text>

      <g class="wa-glow" filter={glow}>
        <path class="wa-wire" d="M92 93H101M188 93H197M284 93H293" />
      </g>
      {[110, 206, 302].map((x) => <path class="wa-b" d={arrow(x, 93)} />)}

      {/* what happens when the user changes their mind, or something fails */}
      <path class="sa-dash" d="M230 112V177H215" />
      <path class="sa-dash" d="M149 160V121" />
      <path class="sa-dash" d="M341 112V151" />
      <path class="sa-dash" d="M302 177H262V121" />
      <path class="sa-dimf" d={arrow(206, 177, 'l')} />
      <path class="sa-dimf" d={arrow(149, 112, 'u')} />
      <path class="sa-dimf" d={arrow(341, 160, 'd')} />
      <path class="sa-dimf" d={arrow(262, 112, 'u')} />
      <text x="143" y="143" text-anchor="end">edit</text>
      <text x="348" y="140">error</text>

      {['Start', 'Choose', 'Review', 'Confirm'].map((t, i) => (
        <>
          <rect class={i === 3 ? 'wa-b' : 'wa-cd'} x={14.5 + i * 96} y="74.5" width="77" height="37" rx="10" />
          <text class={i === 3 ? 'sa-t sa-w' : 'sa-t'} x={53 + i * 96} y="97.3" text-anchor="middle">{t}</text>
          {i < 3 && <circle class="wa-port" cx={92 + i * 96} cy="93" r="3.6" />}
        </>
      ))}
      <rect class="sa-dbox" x="134.5" y="160.5" width="71" height="33" rx="9" />
      <text class="sa-t" x="170" y="181.3" text-anchor="middle">Edit</text>
      <rect class="sa-dbox" x="302.5" y="160.5" width="77" height="33" rx="9" />
      <text class="sa-t" x="341" y="181.3" text-anchor="middle">Error</text>

      {/* the sign-off */}
      <rect class="wa-cd" x="14.5" y="224.5" width="365" height="50" rx="10" />
      {([[38, 'wa-g2'], [54, 'wa-g1'], [70, 'wa-bt']] as [number, string][]).map(([x, c]) => (
        <>
          <circle class={`${c} sa-ring`} cx={x} cy="249.5" r="11" />
          <circle class="sa-bg" cx={x} cy="246.6" r="3.3" />
          <path class="sa-bg" d={`M${x - 6} ${256.6}a6 5.4 0 0 1 12 0z`} />
        </>
      ))}
      <text class="sa-t" x="92" y="247">Confirmed with stakeholders</text>
      <text x="92" y="261">before any screen is designed</text>
      <circle class="wa-b" cx="356" cy="249.5" r="11" />
      <path class="sa-tick" d={tick(356, 249.5)} />
    </>
  )}

  {kind === 'screens' && (
    <>
      {states.map(([t, x, y], i) => (
        <>
          <text class={i === 0 ? 'on' : undefined} x={x} y={y - 8}>{t}</text>
          <rect class="wa-fr" x={x} y={y} width="178" height="106" rx="6" />
          <rect class="wa-k" x={x + 10} y={y + 9} width="44" height="6" rx="2" />
          {i !== 2 && <rect class={i === 0 ? 'wa-b' : 'wa-g1'} x={x + 138} y={y + 6} width="30" height="12" rx="4" />}
          <path class="wa-ln" d={`M${x} ${y + 24.5}h178`} />
        </>
      ))}

      {/* default: the table, filled */}
      {[68, 84, 100, 116].map((y, i) => (
        <>
          <rect class="wa-g1" x="24" y={y - 1} width="8" height="8" rx="2" />
          <rect class="wa-g2" x="38" y={y + 0.5} width={[56, 44, 60, 48][i]} height="5" rx="2.5" />
          <rect class="wa-g1" x="110" y={y + 0.5} width="26" height="5" rx="2.5" />
          <rect class={['wa-b', 'wa-bt', 'wa-g1', 'wa-bt'][i]} x="154" y={y - 2} width="28" height="10" rx="5" />
        </>
      ))}

      {/* empty: nothing yet, and one clear next step */}
      <rect class="sa-dbox" x="285.5" y="64.5" width="23" height="23" rx="6" />
      <path class="sa-ico" d="M297 71v10M292 76h10" />
      <rect class="wa-k" x="267" y="96" width="60" height="5" rx="2.5" />
      <rect class="wa-g2" x="257" y="106" width="80" height="4" rx="2" />
      <rect class="wa-b" x="275" y="117" width="44" height="13" rx="4" />

      {/* loading: the shape of the content, pulsing */}
      <circle class="sa-spin" cx="167" cy="184" r="5" />
      {[208, 224, 240, 256].map((y, i) => <rect class="wa-g1 sa-skel" x="24" y={y} width={[158, 120, 146, 90][i]} height="8" rx="4" style={`animation-delay:${i * 0.15}s`} />)}

      {/* error: what went wrong, and a way back */}
      <rect class="sa-err" x="218.5" y="204.5" width="157" height="26" rx="6" />
      <circle class="wa-k" cx="232" cy="217.5" r="7" />
      <path class="sa-bang" d="M232 213.6v4.2" />
      <circle class="sa-bg" cx="232" cy="221.2" r="1.1" />
      <rect class="wa-k" x="246" y="211" width="64" height="5" rx="2.5" />
      <rect class="wa-g2" x="246" y="220" width="96" height="4" rx="2" />
      <rect class="wa-o" x="218.5" y="240.5" width="55" height="15" rx="4.5" />
      <rect class="wa-k" x="232" y="246" width="28" height="4" rx="2" />
      <rect class="wa-g0" x="218" y="264" width="150" height="6" rx="3" />
    </>
  )}

  {kind === 'prototype' && (
    <>
      <text class="on" x="14" y="40">Prototype · Figma Make</text>
      <text x="296" y="40">Demo</text>

      <g class="wa-glow" filter={glow}>
        <path class="wa-wire" d="M116 175C142 175 132 112 151 112" />
        <path class="wa-wire" d="M272 122H287" />
      </g>
      <path class="wa-spark" pathLength="100" d="M116 175C142 175 132 112 151 112" />
      <path class="wa-b" d={arrow(160, 112)} />
      <path class="wa-b" d={arrow(296, 122)} />

      {/* screen one: a list and the button that is clicked */}
      <rect class="wa-fr" x="14" y="48" width="112" height="148" rx="6" />
      <rect class="wa-k" x="24" y="59" width="40" height="6" rx="2" />
      {[76, 100, 124].map((y, i) => (
        <>
