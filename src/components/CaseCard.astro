---
// One case study card, used on the Work page and the home page.
// Top: full-bleed picture on a grey panel. Bottom: text on the card's own (white) background.
import { Image } from 'astro:assets';
import { asset } from '../data/images';
import Wire from './Wire.astro';

const PROCESS_STEPS = ['Domain', 'Colours', 'Layouts', 'Flows', 'Screens', 'Prototype', 'Build', 'Test'];

interface Props {
  href: string;
  label: string;
  title: string;
  line: string;
  tags?: string[];
  cover?: string;
  mini?: any;
  process?: boolean;
  eager?: boolean;
  heading?: 'h2' | 'h3';
}
const { href, label, title, line, tags = [], cover, mini, process = false, eager = false, heading = 'h2' } = Astro.props;
const H = heading;
---
<a class="case" href={href} data-tags={tags.join('|')}>
  <div class:list={['mini', { media: !!cover }]}>
    {process ? (
      <div class="mini-process" aria-hidden="true">{PROCESS_STEPS.map((x, k) => <span><i>{String(k + 1).padStart(2, '0')}</i>{x}</span>)}</div>
    ) : cover ? (
      <Image src={asset(cover)} alt="" widths={[400, 640, 900]} sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 400px" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} />
    ) : (
      <Wire variant={mini} ann={false} />
    )}
  </div>
  <div class="case-body">
    <span class="n">{label}</span>
    <H>{title}</H>
    <p>{line}</p>
    {tags.length > 0 && <div class="chips">{tags.map((t) => <span class="chip">{t}</span>)}</div>}
  </div>
</a>
