---
import { skills, GROUPS } from '../data/skills';
const shown = skills.filter((s) => s.status === 'shown').length;
---
<section id="capabilities">
  <div class="in">
    <div class="section-head">
      <span class="spec" data-reveal>Section / Capabilities · <b>{shown} shown</b> · {skills.length - shown} in progress</span>
      <h2 data-split>Capabilities</h2>
      <p data-reveal>Every skill links to the page that shows it. The rest are marked in progress until there's something to show.</p>
    </div>
    <div class="caps" data-stagger>
      {GROUPS.map((g) => (
        <div class="cap-col">
          <h3 class="eyebrow">{g}</h3>
          <ul>
            {skills.filter((s) => s.group === g).map((s) => (
              <li id={`skill-${s.id}`}>
                {s.status === 'shown'
                  ? <a href={s.proof[0].href}><span>{s.label}</span><small>{s.proof[0].title} →</small></a>
                  : <span class="wip"><span>{s.label}</span><small>In progress</small></span>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
