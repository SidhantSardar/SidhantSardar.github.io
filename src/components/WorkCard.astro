---
// One "Work" card (home page and /work/). Top: a drawn cover on a grey panel (WorkArt).
// Bottom: text on white. The whole card opens `href`; the small links below stay clickable on their own.
import WorkArt from './WorkArt.astro';
import type { WorkItem } from '../data/work';

interface Props extends WorkItem { heading?: 'h2' | 'h3' }
const { href, label, title, line, tags, art, links, heading = 'h3' } = Astro.props;
const H = heading;
---
<article class="case work-card">
  <div class="mini media"><WorkArt kind={art} /></div>
  <div class="case-body">
    <span class="n">{label}</span>
    <H><a class="card-main" href={href}>{title}</a></H>
    <p>{line}</p>
    <div class="chips">{tags.map((t) => <span class="chip">{t}</span>)}</div>
    <div class="work-links">
      {links.map((l) => (
        <a class="link-arrow" href={l.href} {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}>{l.text} <span class="ar">{l.external ? '↗' : '→'}</span></a>
      ))}
    </div>
  </div>
</article>
