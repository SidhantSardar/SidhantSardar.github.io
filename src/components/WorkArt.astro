      <rect class="wa-k" x="162" y="96" width="58" height="7.5" rx="2" />
      <rect class="wa-g2" x="162" y="110" width="66" height="3.5" rx="1.75" />
      <rect class="wa-g2" x="162" y="117" width="48" height="3.5" rx="1.75" />
