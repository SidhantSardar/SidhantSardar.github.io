---
// Covers for the Work cards: drawn, not screenshots, but drawn to look like the real thing.
// Each cover is a light product screen with real words on it and the people who use it: a teammate's
// comment, an editor's name, the designer's cursor. No neon, no grid: a calm, human scene.
// Sample names and numbers only; no real customer data.
//   product  the Altrum AI web app: a dashboard a risk lead opens in the morning
//   merge    two Webflow sites (altrum.ai, aligne.ai) becoming one site built in code
//   cms      World of Gears: a CMS entry and the page it fills
//   site     the Altrum AI product page, with the app in its hero
// Styles: ".wh" below (always light, like a real screen, in both themes).
interface Props { kind: 'product' | 'merge' | 'cms' | 'site' }
const { kind } = Astro.props;
const id = `wh-${kind}`;
---
<svg class="wa wh" viewBox="0 0 400 250" aria-hidden="true" focusable="false">
  <defs>
    <filter id={`${id}-sh`} x="-10%" y="-10%" width="120%" height="130%">
      <feDropShadow dx="0" dy="6" stdDeviation="7" flood-color="#0B1030" flood-opacity=".22" />
    </filter>
    <filter id={`${id}-sh2`} x="-20%" y="-20%" width="140%" height="160%">
      <feDropShadow dx="0" dy="3" stdDeviation="3.5" flood-color="#0B1030" flood-opacity=".25" />
    </filter>
  </defs>

  {kind === 'product' && (
    <>
      <g filter={`url(#${id}-sh)`}>
        <rect class="wh-win" x="26" y="20" width="348" height="214" rx="8" />
      </g>
      {/* window bar */}
      <circle cx="38" cy="31" r="2.6" fill="#FF6159" /><circle cx="46" cy="31" r="2.6" fill="#FFBD2E" /><circle cx="54" cy="31" r="2.6" fill="#28C941" />
      <rect class="wh-url" x="140" y="26" width="120" height="10" rx="5" /><text class="wh-u" x="200" y="33.4" text-anchor="middle">app.altrum.ai/overview</text>
      <line class="wh-ln" x1="26" y1="42" x2="374" y2="42" />
      {/* sidebar */}
      <rect class="wh-side" x="26" y="42" width="78" height="192" />
      <rect x="35" y="51" width="9" height="9" rx="2.5" fill="#2E3BFF" /><text class="wh-b" x="49" y="58.6">Altrum AI</text>
      {['Overview', 'AI systems', 'Assessments', 'Policies', 'Incidents'].map((t, i) => (
        <>
          {i === 0 && <rect x="31" y="68" width="68" height="13" rx="3" fill="#E8EAFF" />}
          <text class={i === 0 ? 'wh-nav on' : 'wh-nav'} x="38" y={77 + i * 16}>{t}</text>
        </>
      ))}
      <circle cx="40" cy="220" r="5.5" fill="#E9B78F" /><text class="wh-s" x="50" y="222.5">Priya S.</text>
      {/* page */}
      <text class="wh-h" x="114" y="62">Good morning, Priya</text>
      <text class="wh-s" x="114" y="73">3 systems need a review this week</text>
      <rect x="312" y="53" width="52" height="15" rx="4" fill="#2E3BFF" /><text class="wh-btn" x="338" y="63" text-anchor="middle">Add system</text>
      {[['AI systems', '24', ''], ['Open risks', '3', 'up'], ['Policies', '12', '']].map(([k, v, f], i) => (
        <>
          <rect class="wh-card" x={114 + i * 84} y="83" width="76" height="40" rx="5" />
          <text class="wh-s" x={122 + i * 84} y="96">{k}</text>
          <text class="wh-num" x={122 + i * 84} y="115" fill={f ? '#D93A2B' : undefined}>{v}</text>
        </>
      ))}
      {/* table */}
      <rect class="wh-card" x="114" y="131" width="250" height="92" rx="5" />
      <text class="wh-th" x="122" y="144">System</text><text class="wh-th" x="236" y="144">Owner</text><text class="wh-th" x="306" y="144">Risk</text>
      {[['Loan triage model', 'Credit team', 'High', '#FDE4E1', '#B42318'], ['Support chatbot', 'Customer care', 'Low', '#DCF5E6', '#127A3E'], ['Fraud alerts', 'Risk office', 'Medium', '#FFF1D6', '#9A5B00'], ['HR screening', 'People ops', 'Review', '#E8EAFF', '#2E3BFF']].map(([s, o, r, bg, fg], i) => (
        <>
          <line class="wh-ln" x1="122" y1={150 + i * 18} x2="356" y2={150 + i * 18} />
          <text class="wh-t" x="122" y={162 + i * 18}>{s}</text>
          <text class="wh-s" x="236" y={162 + i * 18}>{o}</text>
          <rect x="304" y={154 + i * 18} width="34" height="11" rx="5.5" fill={bg} />
          <text class="wh-pill" x="321" y={162 + i * 18} text-anchor="middle" fill={fg}>{r}</text>
        </>
      ))}
      {/* a teammate's comment on the design */}
      <g filter={`url(#${id}-sh2)`}>
        <rect class="wh-note" x="286" y="192" width="106" height="38" rx="7" />
      </g>
      <circle cx="297" cy="203" r="5.5" fill="#B9845C" /><text class="wh-b" x="306" y="205.5">Rahul · Team lead</text>
      <text class="wh-t" x="294" y="221">Show risk first, nice.</text>
      <g class="wh-cur" transform="translate(250 106)">
        <path d="M0 0 4.3 13 6.7 7.3 12.6 5.3z" fill="#2E3BFF" stroke="#fff" stroke-width="1.2" stroke-linejoin="round" />
        <rect x="9" y="12" width="40" height="14" rx="4" fill="#2E3BFF" /><text class="wh-btn" x="29" y="21.8" text-anchor="middle">Sidhant</text>
      </g>
    </>
  )}

  {kind === 'merge' && (
    <>
      {/* before: two Webflow sites */}
      {[['altrum.ai', 'Govern every AI', 'in your company', 28], ['aligne.ai', 'Responsible AI,', 'done properly', 136]].map(([u, h1, h2, y]) => (
        <>
          <g filter={`url(#${id}-sh2)`}><rect class="wh-win" x="20" y={y} width="124" height="86" rx="6" /></g>
          <rect class="wh-url" x="44" y={+y + 5} width="76" height="8" rx="4" /><text class="wh-u" x="82" y={+y + 11.2} text-anchor="middle">{u}</text>
          <text class="wh-h2" x="30" y={+y + 32}>{h1}</text><text class="wh-h2" x="30" y={+y + 43}>{h2}</text>
          <text class="wh-s" x="30" y={+y + 55}>Built in Webflow</text>
          <rect x="30" y={+y + 62} width="38" height="12" rx="3.5" fill="#14161A" /><text class="wh-btn" x="49" y={+y + 70.4} text-anchor="middle">Book a demo</text>
        </>
      ))}
      <path class="wh-arrow" d="M146 71C172 71 166 125 190 125M146 179C172 179 166 125 190 125" />
      <path d="M197 125l-8-4.6v9.2z" fill="#2E3BFF" />
      {/* after: one site, in code */}
      <g filter={`url(#${id}-sh)`}><rect class="wh-win" x="200" y="22" width="182" height="206" rx="8" /></g>
      <rect class="wh-url" x="246" y="28" width="90" height="10" rx="5" /><text class="wh-u" x="291" y="35.4" text-anchor="middle">aligne.ai</text>
      <line class="wh-ln" x1="200" y1="44" x2="382" y2="44" />
      <text class="wh-b" x="210" y="57">Aligne AI</text>
      {['Altrum', 'Services', 'Insights'].map((t, i) => <text class="wh-s" x={268 + i * 30} y="57">{t}</text>)}
      <text class="wh-h" x="210" y="80">Responsible AI</text><text class="wh-h" x="210" y="93">for enterprises</text>
      <text class="wh-s" x="210" y="106">Consulting and the Altrum platform, in one place.</text>
      <rect x="210" y="113" width="46" height="14" rx="4" fill="#2E3BFF" /><text class="wh-btn" x="233" y="122.6" text-anchor="middle">Book a demo</text>
      <rect class="wh-card" x="260" y="113" width="44" height="14" rx="4" /><text class="wh-t" x="282" y="122.6" text-anchor="middle">Our work</text>
      {[['Altrum platform', 'Govern every AI system'], ['Advisory', 'Policy, risk and audits']].map(([a, b], i) => (
        <>
          <rect class="wh-card" x={210 + i * 86} y="138" width="80" height="44" rx="5" />
          <rect x={217 + i * 86} y="145" width="9" height="9" rx="2.5" fill={i ? '#14161A' : '#2E3BFF'} />
          <text class="wh-t" x={217 + i * 86} y="166">{a}</text><text class="wh-s" x={217 + i * 86} y="176">{b}</text>
        </>
      ))}
      <rect x="210" y="192" width="162" height="26" rx="5" fill="#F3F1EC" />
      <text class="wh-s" x="218" y="203">New post published by Maya, sales</text>
      <text class="wh-t" x="218" y="213">“How banks audit AI models”</text>
      <g class="wh-cur" transform="translate(330 150)">
        <path d="M0 0 4.3 13 6.7 7.3 12.6 5.3z" fill="#2E3BFF" stroke="#fff" stroke-width="1.2" stroke-linejoin="round" />
        <rect x="9" y="12" width="40" height="14" rx="4" fill="#2E3BFF" /><text class="wh-btn" x="29" y="21.8" text-anchor="middle">Sidhant</text>
      </g>
    </>
  )}

  {kind === 'cms' && (
    <>
      {/* the CMS: an entry being edited by the client's team */}
      <g filter={`url(#${id}-sh)`}><rect class="wh-win" x="18" y="30" width="146" height="190" rx="7" /></g>
      <text class="wh-b" x="28" y="46">Case studies</text><text class="wh-s" x="128" y="46">12 items</text>
      <line class="wh-ln" x1="18" y1="53" x2="164" y2="53" />
      {['Supplier audit, Vietnam', 'Carbon baseline, Germany', 'ESG toolbox launch', 'Factory visit playbook'].map((t, i) => (
        <>
          {i === 1 && <rect x="22" y={58 + i * 22} width="138" height="20" rx="4" fill="#E8EAFF" />}
          <rect x="28" y={63 + i * 22} width="10" height="10" rx="2.5" fill={['#7FB685', '#2E3BFF', '#E9B44C', '#C9CDD6'][i]} />
          <text class={i === 1 ? 'wh-t on' : 'wh-t'} x="44" y={71 + i * 22}>{t}</text>
        </>
      ))}
      <line class="wh-ln" x1="18" y1="152" x2="164" y2="152" />
      <circle cx="31" cy="168" r="6" fill="#D9A27C" />
      <text class="wh-t" x="42" y="166">Anna, marketing</text><text class="wh-s" x="42" y="176">Published 2 hours ago</text>
      <rect x="28" y="190" width="54" height="15" rx="4" fill="#127A3E" /><text class="wh-btn" x="55" y="200" text-anchor="middle">Published</text>
      {/* the page it fills */}
      <path class="wh-arrow" d="M160 90C184 90 178 158 200 158" /><path d="M206 158l-8-4.6v9.2z" fill="#2E3BFF" />
      <g filter={`url(#${id}-sh)`}><rect class="wh-win" x="208" y="20" width="176" height="210" rx="8" /></g>
      <rect class="wh-url" x="248" y="26" width="96" height="10" rx="5" /><text class="wh-u" x="296" y="33.4" text-anchor="middle">worldofgears.com</text>
      <rect x="208" y="42" width="176" height="62" fill="#1F3B2D" />
      <text x="218" y="66" class="wh-hw">Sustainability</text><text x="218" y="80" class="wh-hw">Toolbox</text>
      <text x="218" y="94" class="wh-sw">Practical guides for supply chains in 17 countries</text>
      <text class="wh-b" x="218" y="120">Case studies</text>
      {[['Carbon baseline,', 'Germany', '#2E3BFF'], ['Supplier audit,', 'Vietnam', '#7FB685']].map(([a, b, c], i) => (
        <>
          <rect class={i === 0 ? 'wh-card hi' : 'wh-card'} x={218 + i * 82} y="128" width="76" height="90" rx="5" />
          <rect x={223 + i * 82} y="133" width="66" height="40" rx="3" fill={c} opacity=".18" />
          <circle cx={256 + i * 82} cy="153" r="9" fill={c} opacity=".55" />
          <text class="wh-t" x={224 + i * 82} y="187">{a}</text><text class="wh-t" x={224 + i * 82} y="197">{b}</text>
          <text class="wh-s" x={224 + i * 82} y="210">Read the story →</text>
        </>
      ))}
    </>
  )}

  {kind === 'site' && (
    <>
      <g filter={`url(#${id}-sh)`}><rect class="wh-win" x="22" y="18" width="356" height="216" rx="8" /></g>
      <circle cx="34" cy="29" r="2.6" fill="#FF6159" /><circle cx="42" cy="29" r="2.6" fill="#FFBD2E" /><circle cx="50" cy="29" r="2.6" fill="#28C941" />
      <rect class="wh-url" x="150" y="24" width="100" height="10" rx="5" /><text class="wh-u" x="200" y="31.4" text-anchor="middle">altrum.ai</text>
      <line class="wh-ln" x1="22" y1="40" x2="378" y2="40" />
      <rect x="32" y="49" width="9" height="9" rx="2.5" fill="#2E3BFF" /><text class="wh-b" x="45" y="56.6">Altrum AI</text>
      {['Platform', 'Use cases', 'Pricing'].map((t, i) => <text class="wh-s" x={210 + i * 40} y="56.6">{t}</text>)}
      <rect x="330" y="48" width="38" height="12" rx="3.5" fill="#2E3BFF" /><text class="wh-btn" x="349" y="56.4" text-anchor="middle">Get a demo</text>
      <text class="wh-h" x="32" y="86">Know every AI</text><text class="wh-h" x="32" y="100">your company uses</text>
      <text class="wh-s" x="32" y="114">Register, assess and control AI systems,</text>
      <text class="wh-s" x="32" y="123">with an audit trail your regulator trusts.</text>
      <rect x="32" y="131" width="50" height="15" rx="4" fill="#2E3BFF" /><text class="wh-btn" x="57" y="141" text-anchor="middle">Book a demo</text>
      <rect class="wh-card" x="87" y="131" width="50" height="15" rx="4" /><text class="wh-t" x="112" y="141" text-anchor="middle">See how</text>
      {/* the app, shown in the hero */}
      <g filter={`url(#${id}-sh2)`}><rect class="wh-card" x="196" y="70" width="172" height="90" rx="6" /></g>
      <text class="wh-s" x="204" y="82">AI systems · this quarter</text>
      <path d="M206 140l18-12 16 6 18-16 18 7 20-15 26-6" fill="none" stroke="#2E3BFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M206 140l18-12 16 6 18-16 18 7 20-15 26-6V152H206z" fill="#2E3BFF" opacity=".08" />
      <rect x="306" y="76" width="54" height="13" rx="6.5" fill="#DCF5E6" /><text class="wh-pill" x="333" y="85" text-anchor="middle" fill="#127A3E">All reviewed</text>
      {/* trust line and a quote from a customer */}
      <line class="wh-ln" x1="32" y1="172" x2="368" y2="172" />
      <text class="wh-th" x="32" y="186">TRUSTED BY RISK TEAMS AT</text>
      {['Northwind Bank', 'Fabrikam', 'Contoso Group'].map((t, i) => <text class="wh-logo" x={32 + i * 74} y="202">{t}</text>)}
      <g filter={`url(#${id}-sh2)`}><rect class="wh-note" x="262" y="180" width="106" height="44" rx="7" /></g>
      <circle cx="273" cy="192" r="5.5" fill="#8D5A3B" /><text class="wh-b" x="282" y="194.5">Head of Risk</text>
      <text class="wh-t" x="270" y="208">“Our first audit took</text><text class="wh-t" x="270" y="218">days, not months.”</text>
      <g class="wh-cur" transform="translate(150 150)">
        <path d="M0 0 4.3 13 6.7 7.3 12.6 5.3z" fill="#2E3BFF" stroke="#fff" stroke-width="1.2" stroke-linejoin="round" />
        <rect x="9" y="12" width="40" height="14" rx="4" fill="#2E3BFF" /><text class="wh-btn" x="29" y="21.8" text-anchor="middle">Sidhant</text>
      </g>
    </>
  )}
</svg>

<style is:global>
  /* Real screens are light, in both themes */
  .wa.wh text{font-family:var(--body);letter-spacing:0;fill:#14161A}
  .wh .wh-win{fill:#FFFFFF}
  .wh .wh-side{fill:#F7F7F9}
  .wh .wh-card{fill:#FFFFFF;stroke:#E4E6EC;stroke-width:1}
  .wh .wh-card.hi{stroke:#2E3BFF;stroke-width:1.4}
  .wh .wh-note{fill:#FFFFFF}
  .wh .wh-url{fill:#F1F2F5}
  .wh .wh-ln{stroke:#ECEDF1;stroke-width:1}
  .wh .wh-arrow{fill:none;stroke:#2E3BFF;stroke-width:1.6;stroke-dasharray:4 3;stroke-linecap:round}
  .wa.wh .wh-u{font-family:var(--mono);font-size:6px;fill:#6B7080}
  .wa.wh .wh-h{font-size:12.5px;font-weight:700;letter-spacing:-.02em}
  .wa.wh .wh-h2{font-size:9.5px;font-weight:700;letter-spacing:-.01em}
  .wa.wh .wh-hw{font-size:13px;font-weight:700;letter-spacing:-.02em;fill:#FFFFFF}
  .wa.wh .wh-sw{font-size:5.6px;fill:#CFE3D6}
  .wa.wh .wh-b{font-size:7px;font-weight:600}
  .wa.wh .wh-t{font-size:6.6px;font-weight:500}
  .wa.wh .wh-t.on{fill:#2E3BFF;font-weight:600}
  .wa.wh .wh-s{font-size:5.8px;fill:#6B7080}
  .wa.wh .wh-th{font-size:5.4px;font-weight:600;fill:#8A8F9C;letter-spacing:.04em}
  .wa.wh .wh-nav{font-size:6.4px;fill:#5A5F6E}
  .wa.wh .wh-nav.on{fill:#2E3BFF;font-weight:600}
  .wa.wh .wh-num{font-size:14px;font-weight:700;letter-spacing:-.02em}
  .wa.wh .wh-pill{font-size:5.4px;font-weight:600}
  .wa.wh .wh-btn{font-size:5.8px;font-weight:600;fill:#FFFFFF}
  .wa.wh .wh-logo{font-size:7.5px;font-weight:700;fill:#9CA0AC;letter-spacing:-.01em}
  .wh .wh-cur{transition:transform .6s cubic-bezier(.2,.7,.2,1)}
  .case:hover .wh .wh-cur{transform:translate(7px,-5px)}
</style>
