      <rect class="wa-b" x="29" y="99" width="98" height="19" rx="4" />
      <rect class="wa-w" x="34" y="104" width="9" height="9" rx="2" />
      <rect class="wa-w" x="49" y="106" width="52" height="5" rx="2.5" />
      <rect class="wa-w" x="110" y="106" width="12" height="5" rx="2.5" opacity=".6" />

      {/* the page it feeds, built in Webflow */}
