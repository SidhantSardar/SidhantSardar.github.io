---
// Covers for the Work cards: drawn SVGs instead of screenshots.
// One family: each cover is a corner of a Figma canvas, with named frames, one frame selected in
// blue, blue prototype wires between frames, and the designer's cursor. Colours come from the
// site's tokens (styles in global.css, ".wa"), so the covers follow light and dark mode.
//   product  a product screen being designed (Altrum AI web app)
//   merge    two Webflow sites wired into one site built in code (Aligne AI)
//   cms      CMS collections feeding a Webflow page (World of Gears)
//   site     the site pages feeding a SaaS product page with its dashboard in the hero (Altrum AI website)
interface Props { kind: 'product' | 'merge' | 'cms' | 'site' }
const { kind } = Astro.props;

/** Four selection handles for a frame at x, y with width w and height h. */
const handles = (x: number, y: number, w: number, h: number) =>
  [[x, y], [x + w, y], [x, y + h], [x + w, y + h]].map(([cx, cy]) => ({ x: cx - 3, y: cy - 3 }));

// Light for the dark theme (switched on in global.css): a soft glow behind the selected frame, and a
// glow filter for wires and the selection. Ids carry the kind, so two covers on a page never clash.
const glow = `url(#wa-glow-${kind})`;
const halo = { product: [192, 128, 215, 135], merge: [289, 134, 150, 135], cms: [271, 134, 170, 135], site: [262, 134, 175, 135] }[kind];
---
<svg class="wa" viewBox="0 0 400 250" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id={`wa-halo-${kind}`}><stop offset="0" stop-color="#2E3BFF" stop-opacity=".36" /><stop offset="1" stop-color="#2E3BFF" stop-opacity="0" /></radialGradient>
    <filter id={`wa-glow-${kind}`} filterUnits="userSpaceOnUse" x="0" y="0" width="400" height="250" color-interpolation-filters="sRGB">
      <feGaussianBlur stdDeviation="3" result="b" />
      <feComponentTransfer in="b" result="g"><feFuncA type="linear" slope="1.5" /></feComponentTransfer>
      <feMerge><feMergeNode in="g" /><feMergeNode in="SourceGraphic" /></feMerge>
    </filter>
  </defs>
  <ellipse class="wa-halo" cx={halo[0]} cy={halo[1]} rx={halo[2]} ry={halo[3]} fill={`url(#wa-halo-${kind})`} />
  {kind === 'product' && (
    <>
      <text class="on" x="48" y="33">Dashboard</text>
      <rect class="wa-fr" x="48" y="40" width="288" height="176" />

      {/* sidebar */}
      <rect class="wa-g0" x="48.5" y="40.5" width="57.5" height="175" />
      <path class="wa-ln" d="M106 40v176" />
      <rect class="wa-k" x="58" y="50" width="10" height="10" rx="2.5" />
      <rect class="wa-g2" x="73" y="52.5" width="22" height="5" rx="2.5" />
      <rect class="wa-bt" x="53" y="70" width="48" height="14" rx="3.5" />
      <rect class="wa-b" x="58" y="74" width="6" height="6" rx="1.5" />
      <rect class="wa-b" x="69" y="74.5" width="24" height="5" rx="2.5" />
      {[[92, 28], [108, 20], [124, 26]].map(([y, w]) => (
        <>
          <rect class="wa-g2" x="58" y={y} width="6" height="6" rx="1.5" />
          <rect class="wa-g2" x="69" y={y + 0.5} width={w} height="5" rx="2.5" />
        </>
      ))}
      <circle class="wa-g2" cx="63" cy="202" r="5" />
      <rect class="wa-g2" x="73" y="199.5" width="22" height="5" rx="2.5" />

      {/* header: page title and the primary button */}
      <rect class="wa-k" x="118" y="51" width="58" height="8.5" rx="2" />
      <rect class="wa-g2" x="118" y="64.5" width="88" height="4.5" rx="2.25" />
      <rect class="wa-b" x="284" y="50" width="40" height="15" rx="4" />
      <rect class="wa-w" x="293" y="55.5" width="22" height="4" rx="2" />

      {/* three stat tiles: the first one is the blue focal point */}
      <rect class="wa-b" x="118" y="80" width="64" height="38" rx="5" />
      <rect class="wa-w" x="126" y="88" width="24" height="4" rx="2" opacity=".7" />
      <rect class="wa-w" x="126" y="99" width="34" height="10" rx="2" />
      <rect class="wa-cd" x="189.5" y="80.5" width="63" height="37" rx="5" />
      <rect class="wa-g2" x="197" y="88" width="24" height="4" rx="2" />
      <rect class="wa-k" x="197" y="99" width="28" height="10" rx="2" />
      <rect class="wa-cd" x="260.5" y="80.5" width="63" height="37" rx="5" />
      <rect class="wa-g2" x="268" y="88" width="24" height="4" rx="2" />
      <rect class="wa-k" x="268" y="99" width="38" height="10" rx="2" />

      {/* chart */}
      <rect class="wa-cd" x="118.5" y="126.5" width="134" height="77" rx="5" />
      <rect class="wa-g2" x="126" y="134" width="40" height="4.5" rx="2.25" />
      <path class="wa-ln" d="M126 154.5h119M126 170.5h119M126 186.5h119" />
      <path class="wa-bt" d="M126 188 143 180 160 184 177 168 194 172 211 156 228 160 245 146V196H126z" />
      <path class="wa-line wa-glow" filter={glow} d="M126 188 143 180 160 184 177 168 194 172 211 156 228 160 245 146" />
      <path class="wa-spark" pathLength="100" d="M126 188 143 180 160 184 177 168 194 172 211 156 228 160 245 146" />
      <circle class="wa-port" cx="245" cy="146" r="3.4" />

      {/* list */}
      <rect class="wa-cd" x="260.5" y="126.5" width="63" height="77" rx="5" />
      {[[140, 38, true], [156, 30, false], [172, 36, false], [188, 26, false]].map(([y, w, on]) => (
        <>
          <circle class={on ? 'wa-b' : 'wa-g2'} cx="270" cy={y} r="2.5" />
          <rect class="wa-g2" x="277" y={Number(y) - 2.25} width={w} height="4.5" rx="2.25" />
        </>
      ))}

      {/* the frame is selected: bounding box and handles */}
      <rect class="wa-sel wa-glow" filter={glow} x="48" y="40" width="288" height="176" />
      {handles(48, 40, 288, 176).map((h) => <rect class="wa-h" x={h.x} y={h.y} width="6" height="6" />)}

      <g transform="translate(316 158)"><g class="wa-cur">
        <path d="M0 0 4.3 13 6.7 7.3 12.6 5.3z" />
        <rect class="wa-b" x="9" y="12" width="43" height="15" rx="3.5" />
        <text x="30.5" y="22.6" text-anchor="middle">Sidhant</text>
      </g></g>
    </>
  )}

  {kind === 'merge' && (
    <>
