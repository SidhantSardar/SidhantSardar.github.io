      <rect class="wa-fr" x="166" y="50" width="210" height="168" />
      <circle class="wa-k" cx="179.5" cy="63.5" r="3.5" />
      {[296, 313, 330].map((x) => <rect class="wa-g2" x={x} y="62" width="12" height="3" rx="1.5" />)}
      <rect class="wa-o" x="349.5" y="58.5" width="18" height="10" rx="3" />
      <rect class="wa-g0" x="174" y="76" width="194" height="60" rx="4" />
      <rect class="wa-k" x="184" y="88" width="80" height="7.5" rx="2" />
      <rect class="wa-k" x="184" y="99.5" width="58" height="7.5" rx="2" />
      <rect class="wa-g2" x="184" y="113" width="70" height="3.5" rx="1.75" />
      <rect class="wa-k" x="184" y="122" width="26" height="8" rx="2.5" />
      {/* two gears, for World of Gears */}
      <clipPath id="wa-band"><rect x="174" y="76" width="194" height="60" rx="4" /></clipPath>
      <g clip-path="url(#wa-band)">
        <g class="wa-b" transform="translate(331 103)">
          <circle r="18" />
