      </g></g>
    </>
  )}
  {kind === 'site' && (
    <>
      {/* the site's pages; the product page is picked */}
      <text x="24" y="43">Pages</text>
      <rect class="wa-fr" x="24" y="50" width="100" height="150" rx="5" />
      {[[62, 30], [86, 0], [110, 36], [134, 26], [158, 34]].map(([y, w]) => w > 0 && (
        <>
          <rect class="wa-g2" x="34" y={y} width="9" height="9" rx="2" />
          <rect class="wa-g2" x="49" y={y + 2} width={w} height="5" rx="2.5" />
