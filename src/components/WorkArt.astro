      <rect class="wa-fr" x="204" y="50" width="170" height="168" />
      <rect class="wa-k" x="214" y="60" width="7" height="7" rx="1.75" />
      {[294, 311, 328].map((x) => <rect class="wa-g2" x={x} y="62" width="12" height="3" rx="1.5" />)}
      <rect class="wa-b" x="346" y="58.5" width="18" height="10" rx="3" />
      <rect class="wa-k" x="214" y="84" width="98" height="8.5" rx="2" />
      <rect class="wa-k" x="214" y="97" width="70" height="8.5" rx="2" />
      <rect class="wa-g2" x="214" y="113" width="112" height="3.5" rx="1.75" />
      <rect class="wa-g2" x="214" y="120.5" width="86" height="3.5" rx="1.75" />
      <rect class="wa-b" x="214" y="132" width="36" height="12" rx="3.5" />
      <rect class="wa-o" x="254.5" y="132.5" width="31" height="11" rx="3.5" />
      {/* the two products, now side by side under one roof */}
      <rect class="wa-cd" x="214.5" y="156.5" width="71" height="49" rx="4" />
      <rect class="wa-b" x="222" y="164" width="9" height="9" rx="2.25" />
      <rect class="wa-k" x="222" y="180" width="38" height="5" rx="1.5" />
      <rect class="wa-g2" x="222" y="189.5" width="52" height="3.5" rx="1.75" />
      <rect class="wa-g2" x="222" y="196" width="36" height="3.5" rx="1.75" />
      <rect class="wa-cd" x="292.5" y="156.5" width="71" height="49" rx="4" />
      <rect class="wa-k" x="300" y="164" width="9" height="9" rx="2.25" />
      <rect class="wa-k" x="300" y="180" width="44" height="5" rx="1.5" />
      <rect class="wa-g2" x="300" y="189.5" width="48" height="3.5" rx="1.75" />
      <rect class="wa-g2" x="300" y="196" width="30" height="3.5" rx="1.75" />

      <rect class="wa-sel wa-glow" filter={glow} x="204" y="50" width="170" height="168" />
      {handles(204, 50, 170, 168).map((h) => <rect class="wa-h" x={h.x} y={h.y} width="6" height="6" />)}

      <g transform="translate(330 178)"><g class="wa-cur">
        <path d="M0 0 4.3 13 6.7 7.3 12.6 5.3z" />
        <rect class="wa-b" x="9" y="12" width="43" height="15" rx="3.5" />
        <text x="30.5" y="22.6" text-anchor="middle">Sidhant</text>
      </g></g>
    </>
  )}

  {kind === 'cms' && (
    <>
      {/* the CMS: a list of collections, one of them picked */}
      <text x="24" y="43">CMS Collections</text>
      <rect class="wa-fr" x="24" y="50" width="108" height="150" rx="5" />
      <rect class="wa-k" x="34" y="60" width="40" height="6" rx="1.5" />
      <rect class="wa-g1" x="112" y="59" width="10" height="8" rx="2" />
      {[[80, 46], [128, 38], [152, 44], [176, 30]].map(([y, w]) => (
        <>
          <rect class="wa-g2" x="34" y={y} width="9" height="9" rx="2" />
          <rect class="wa-g2" x="49" y={y + 2} width={w} height="5" rx="2.5" />
          <rect class="wa-g1" x="110" y={y + 2} width="12" height="5" rx="2.5" />
