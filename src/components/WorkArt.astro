      {/* three cards; the first one is filled from the CMS */}
      <rect class="wa-bo" x="174.75" y="146.75" width="58.5" height="58.5" rx="4" />
      <rect class="wa-bt" x="180" y="152" width="48" height="24" rx="2.5" />
      <rect class="wa-k" x="180" y="182" width="36" height="4.5" rx="1.5" />
      <rect class="wa-g2" x="180" y="190.5" width="46" height="3.5" rx="1.75" />
      <rect class="wa-g2" x="180" y="197" width="30" height="3.5" rx="1.75" />
      {[241, 308].map((x) => (
        <>
          <rect class="wa-cd" x={x + 0.5} y="146.5" width="59" height="59" rx="4" />
          <rect class="wa-g1" x={x + 6} y="152" width="48" height="24" rx="2.5" />
          <rect class="wa-k" x={x + 6} y="182" width="32" height="4.5" rx="1.5" />
          <rect class="wa-g2" x={x + 6} y="190.5" width="46" height="3.5" rx="1.75" />
