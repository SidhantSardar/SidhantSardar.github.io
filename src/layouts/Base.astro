---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';

interface Props {
  title?: string;
  description?: string;
  active?: 'home' | 'portfolio' | 'writing';
  /** Share image path in /public. 1200×630 or 1600×900 works on every network. */
  image?: string;
  imageAlt?: string;
  /** 'article' for writing posts, 'website' for everything else. */
  type?: 'website' | 'article';
  /** Keep the page out of search results (used for draft posts). */
  noindex?: boolean;
}

const {
  title = 'Sidhant Sardar · Websites designed in Figma, built in Webflow or code',
  description = 'Sidhant Sardar designs websites and web apps in Figma and builds them in Webflow or code, with a CMS your team updates without a developer.',
  active = 'home',
  image = '/sidhant-full.jpg',
  imageAlt = 'Sidhant Sardar at his desk',
  type = 'website',
  noindex = false,
} = Astro.props;

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#FFFFFF" />
    <script is:inline>
      // Apply the saved theme before first paint. Light is the default.
      (function () {
        var t = 'light';
        try { t = localStorage.getItem('theme') || 'light'; } catch (e) {}
        document.documentElement.setAttribute('data-theme', t);
        var m = document.querySelector('meta[name="theme-color"]');
        if (m) m.setAttribute('content', t === 'dark' ? '#000000' : '#FFFFFF');
      })();
    </script>
    <Analytics />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    {noindex && <meta name="robots" content="noindex" />}

    <!-- Share previews: Open Graph (LinkedIn, WhatsApp, Slack, Facebook) -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Sidhant Sardar" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_GB" />

    <!-- Share previews: X / Twitter (falls back to og: for title, description, image) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={imageAlt} />
    <!-- Icons -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="grid-overlay" aria-hidden="true"><div class="in">{Array.from({ length: 12 }).map(() => <i></i>)}</div></div>

    <nav aria-label="Main">
      <div class="in">
        <a class="logo" href="/">Sidhant<span>.</span></a>
        <div class="links">
          <a href="/" aria-current={active === 'home' ? 'page' : undefined}>Home</a>
          <a href="/portfolio" aria-current={active === 'portfolio' ? 'page' : undefined}>Portfolio</a>
          <a href="/writing" class="hide-sm" aria-current={active === 'writing' ? 'page' : undefined}>Writing</a>
          <a href="/#contact">Contact</a>
        </div>
        <button class="toggle" id="grid-toggle" aria-pressed="false" title="Show the 12-column layout grid">Grid · 12 col</button>
        <button class="theme-switch" id="theme-switch" type="button" aria-label="Dark mode" aria-pressed="false" title="Switch light / dark">
          <span class="sun"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></span>
          <span class="moon"><svg viewBox="0 0 24 24"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg></span>
        </button>
      </div>
    </nav>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer>
      <div class="in mono">
        <span>© {new Date().getFullYear()} Sidhant Sardar</span>
        <span>Designed in Figma · built with Claude Code + Astro · 1240 max · 12 col · 24 gutter</span>
      </div>
    </footer>

    <script>
      import '../scripts/motion.ts';
      const sw = document.getElementById('theme-switch')!;
      const root = document.documentElement;
      const sync = () => sw.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
      sync();
      sw.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', next === 'dark' ? '#000000' : '#FFFFFF');
        sync();
      });
      const t = document.getElementById('grid-toggle')!;
      t.addEventListener('click', () => {
        const on = t.getAttribute('aria-pressed') !== 'true';
        t.setAttribute('aria-pressed', String(on));
        document.body.classList.toggle('grid-on', on);
      });
    </script>
  </body>
</html>
