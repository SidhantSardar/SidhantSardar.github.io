---
// Self-hosted fonts (no Google Fonts request blocking the first paint)
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import { EMAIL, PHONE, PHONE_TEL, LINKEDIN, YOUTUBE, AVAILABILITY } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  active?: 'home' | 'work' | 'portfolio' | 'writing' | 'lab' | 'resume';
  /** Share image path in /public. 1200×630 or 1600×900 works on every network. */
  image?: string;
  imageAlt?: string;
  /** 'article' for writing posts, 'website' for everything else. */
  type?: 'website' | 'article';
  /** Keep the page out of search results (used for draft posts). */
  noindex?: boolean;
}

const {
  title = 'Sidhant Sardar · Websites for B2B consultancies and AI companies',
  description = 'Websites for B2B consultancies and AI companies: designed in Figma, built in Webflow or code, with a dashboard that shows which pages bring in clients.',
  active = 'home',
  image = '/sidhant-full.jpg',
  imageAlt = 'Sidhant Sardar at his desk',
  type = 'website',
  noindex = false,
} = Astro.props;

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;

// The site's pages, in menu order. Used by the top menu and the footer.
// hideSm: left out of the top menu on phones (still listed in the footer).
const pages: { id: NonNullable<Props['active']>; label: string; href: string; hideSm?: boolean }[] = [
  { id: 'home', label: 'Home', href: '/' },
  { id: 'work', label: 'Work', href: '/work/' },
  { id: 'resume', label: 'Resume', href: '/resume/' },
  { id: 'portfolio', label: 'Portfolio', href: '/portfolio', hideSm: true },
  { id: 'writing', label: 'Writing', href: '/writing', hideSm: true },
  { id: 'lab', label: 'Lab', href: '/lab/', hideSm: true },
];
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#FFFFFF" />
    <script is:inline>
      // Apply the saved theme before first paint. Light is the default.
      (function () {
        var t = 'light';
        try { t = localStorage.getItem('theme') || 'light'; } catch (e) {}
        document.documentElement.setAttribute('data-theme', t);
        var m = document.querySelector('meta[name="theme-color"]');
        if (m) m.setAttribute('content', t === 'dark' ? '#000000' : '#FFFFFF');
      })();
    </script>
    <Analytics />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    {noindex && <meta name="robots" content="noindex" />}

    <!-- Share previews: Open Graph (LinkedIn, WhatsApp, Slack, Facebook) -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Sidhant Sardar" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_GB" />

    <!-- Share previews: X / Twitter (falls back to og: for title, description, image) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={imageAlt} />
    <!-- Icons -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="Sidhant Sardar · Writing" href="/rss.xml" />

    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="grid-overlay" aria-hidden="true"><div class="in">{Array.from({ length: 12 }).map(() => <i></i>)}</div></div>

    <nav class="site-nav" aria-label="Main">
      <div class="in">
        <a class="logo" href="/">Sidhant<span>.</span></a>
        <div class="links">
          {pages.map((p) => <a href={p.href} class={p.hideSm ? 'hide-sm' : undefined} aria-current={active === p.id ? 'page' : undefined}>{p.label}</a>)}
          {/* The contact call to action is the footer of every page, so this scrolls to it */}
          <a class="nav-cta" href="#contact" data-track="cta_click" data-track-cta="contact" data-track-location="nav">Contact</a>
        </div>
        <button class="toggle" id="grid-toggle" aria-pressed="false" title="Show the 12-column layout grid">Grid · 12 col</button>
        <button class="theme-switch" id="theme-switch" type="button" aria-label="Dark mode" aria-pressed="false" title="Switch light / dark">
          <span class="sun"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></span>
          <span class="moon"><svg viewBox="0 0 24 24"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg></span>
        </button>
      </div>
    </nav>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <!-- Footer = the contact call to action, on every page. #contact is where "Contact" and
         "Start a project" scroll to. -->
    <footer class="site-footer" id="contact">
      <div class="in">
        <div class="foot-top">
          <span class="spec" data-reveal>Section / Contact</span>
          <h2 data-split>Marketing website not converting? <span class="fix">Let's fix it.</span></h2>
        </div>
        <div class="foot-main">
          <div class="foot-cta">
            <p data-reveal>Send a few lines: what you're building, a link to your current site, and when you need it live.</p>
            <div class="foot-actions" data-reveal>
              <a class="btn primary" href={`mailto:${EMAIL}`} data-track="contact_click" data-track-method="email" data-track-location="contact">Email me <span class="ar">→</span></a>
              {PHONE && <a class="btn" href={`tel:${PHONE_TEL}`} data-track="contact_click" data-track-method="phone" data-track-location="contact">Call {PHONE}</a>}
            </div>
            <div class="foot-mail" data-reveal>
              <a href={`mailto:${EMAIL}`} data-track="contact_click" data-track-method="email" data-track-location="contact"><code>{EMAIL}</code></a>
              <button id="copy" type="button" aria-label="Copy email address" data-email={EMAIL} data-track="contact_click" data-track-method="copy_email" data-track-location="contact">Copy</button>
            </div>
            <p class="avail"><i aria-hidden="true"></i>{AVAILABILITY}</p>
          </div>
          <div class="foot-side">
            <nav class="foot-col" aria-label="Pages">
              <h3>Pages</h3>
              {pages.map((p) => <a href={p.href}>{p.label}</a>)}
            </nav>
            {(LINKEDIN || YOUTUBE) && (
              <div class="foot-col">
                <h3>Elsewhere</h3>
                {LINKEDIN && <a href={LINKEDIN} target="_blank" rel="noopener">LinkedIn<span class="ar">↗</span></a>}
                {YOUTUBE && <a href={YOUTUBE} target="_blank" rel="noopener">YouTube<span class="ar">↗</span></a>}
              </div>
            )}
          </div>
        </div>
        <div class="foot-bar">
          <span>© {new Date().getFullYear()} Sidhant Sardar</span>
          <span>Designed in Figma · built with Claude Code + Astro · 1240 max · 12 col · 24 gutter</span>
        </div>
      </div>
    </footer>

    <script>
      import '../scripts/motion.ts';
      // Copy the email address (footer)
      document.getElementById('copy')?.addEventListener('click', async (e) => {
        const btn = e.currentTarget as HTMLButtonElement;
        try { await navigator.clipboard.writeText(btn.dataset.email ?? ''); btn.textContent = 'Copied'; }
        catch { btn.textContent = 'Select it'; }
        setTimeout(() => (btn.textContent = 'Copy'), 1800);
      });
      const sw = document.getElementById('theme-switch')!;
      const root = document.documentElement;
      const sync = () => sw.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
      sync();
      sw.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', next === 'dark' ? '#000000' : '#FFFFFF');
        sync();
      });
      // Enquiry tracking for GA4. Any element opts in with data-track="<event name>";
      // data-track-<param>="value" attributes become event parameters (data-track-method → method).
      // gtag only exists in production builds, so local clicks are never counted.
      document.addEventListener('click', (e) => {
        const el = (e.target as Element | null)?.closest<HTMLElement>('[data-track]');
        const gtag = (window as unknown as { gtag?: (...args: unknown[]) => void }).gtag;
        if (!el || !gtag) return;
        const params: Record<string, string> = {};
        for (const [k, v] of Object.entries(el.dataset)) {
          if (k.startsWith('track') && k !== 'track' && v) params[k.charAt(5).toLowerCase() + k.slice(6)] = v;
        }
        gtag('event', el.dataset.track, params);
      });

      const t = document.getElementById('grid-toggle')!;
      t.addEventListener('click', () => {
        const on = t.getAttribute('aria-pressed') !== 'true';
        t.setAttribute('aria-pressed', String(on));
        document.body.classList.toggle('grid-on', on);
      });
    </script>
  </body>
</html>
