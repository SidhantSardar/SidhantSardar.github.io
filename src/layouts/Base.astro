---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  active?: 'home' | 'portfolio' | 'writing';
}

const {
  title = 'Sidhant Sardar · Figma & Webflow expert, design engineer in progress',
  description = 'Sidhant Sardar designs web apps in Figma, builds CMS websites in Webflow, and is learning to build interfaces in code.',
  active = 'home',
} = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#FFFFFF" />
    <script is:inline>
      // Apply the saved theme before first paint. Light is the default.
      (function () {
        var t = 'light';
        try { t = localStorage.getItem('theme') || 'light'; } catch (e) {}
        document.documentElement.setAttribute('data-theme', t);
        var m = document.querySelector('meta[name="theme-color"]');
        if (m) m.setAttribute('content', t === 'dark' ? '#000000' : '#FFFFFF');
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/sidhant-full.jpg', Astro.site)} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap" />
  </head>
  <body>
    <div class="grid-overlay" aria-hidden="true"><div class="in">{Array.from({ length: 12 }).map(() => <i></i>)}</div></div>

    <nav>
      <div class="in">
        <a class="logo" href="/">Sidhant<span>.</span></a>
        <div class="links">
          <a href="/" aria-current={active === 'home' ? 'page' : undefined}>Home</a>
          <a href="/portfolio" aria-current={active === 'portfolio' ? 'page' : undefined}>Portfolio</a>
          <a href="/writing" class="hide-sm" aria-current={active === 'writing' ? 'page' : undefined}>Writing</a>
          <a href="/#contact">Contact</a>
        </div>
        <button class="toggle" id="grid-toggle" aria-pressed="false" title="Show the 12-column layout grid">Grid · 12 col</button>
        <button class="theme-switch" id="theme-switch" type="button" aria-label="Dark mode" aria-pressed="false" title="Switch light / dark">
          <span class="sun"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></span>
          <span class="moon"><svg viewBox="0 0 24 24"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg></span>
        </button>
      </div>
    </nav>

    <slot />

    <footer>
      <div class="in mono">
        <span>© {new Date().getFullYear()} Sidhant Sardar</span>
        <span>Designed in Figma · built with Claude Code + Astro · 1240 max · 12 col · 24 gutter</span>
      </div>
    </footer>

    <script>
      import '../scripts/motion.ts';
      const sw = document.getElementById('theme-switch')!;
      const root = document.documentElement;
      const sync = () => sw.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
      sync();
      sw.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', next === 'dark' ? '#000000' : '#FFFFFF');
        sync();
      });
      const t = document.getElementById('grid-toggle')!;
      t.addEventListener('click', () => {
        const on = t.getAttribute('aria-pressed') !== 'true';
        t.setAttribute('aria-pressed', String(on));
        document.body.classList.toggle('grid-on', on);
      });
    </script>
  </body>
</html>
