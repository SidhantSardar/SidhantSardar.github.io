---
// Resume as a web page: share the link instead of a PDF.
// On screen it is a visual page: numbers, icons, tool logos and short lines, with the full text of each
// job one click away under "Details". The PDF and Word downloads, and a print of this page
// (components/ResumeSheet.astro), carry the full text. Everything reads from src/data/resume.mjs.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import WorkArt from '../components/WorkArt.astro';
import ToolText from '../components/ToolText.astro';
import ResumeSheet from '../components/ResumeSheet.astro';
import { Image } from 'astro:assets';
import { asset } from '../data/images';
import { EMAIL, PHONE, LINKEDIN, YOUTUBE } from '../data/profile';
import {
  skills, jobs, projects, fmt, span, tagline, headline, education, icons, contactList, kwHtml,
  lead, toolset, toolkit, loop, loopBack, glance, jobCards, projectArt, skillIcons, bringsShort,
} from '../data/resume.mjs';

const contacts = contactList({ EMAIL, PHONE, LINKEDIN, YOUTUBE });
const host = (u) => u.replace(/^https:\/\/(www\.)?/, '').replace(/\/$/, '');

// Career bar: one segment per job, oldest first, each as wide as the months it lasted.
const ym = (s) => { const [y, m] = s.split('-').map(Number); return y * 12 + m - 1; };
const today = new Date().getUTCFullYear() * 12 + new Date().getUTCMonth();
const career = [...jobs].reverse().map((j, i, all) => ({
  j,
  months: (j.end ? ym(j.end) : today) - ym(j.start) + 1,
  gap: i ? ym(j.start) - ym(all[i - 1].end) - 1 : 0,
  // "Product Designer (UI/UX) & Webflow Developer" → "Product Designer"
  role: j.role.split(/ \(| & /)[0],
  org: j.org.split(' (')[0],
}));
---
<Base active="resume" title="Resume · Sidhant Sardar" description="Sidhant Sardar: UI/UX designer, Webflow developer and AI-assisted developer (Claude Code). 3.5+ years of remote product and web design." image="/sidhant-full.jpg" imageAlt="Sidhant Sardar">
  <div class="in cv">
    <!-- Who, in one screen: name, headline, downloads, and how the work goes round -->
    <header class="rs-head">
      <div class="rs-id">
        <div class="intro-id">
          <div class="avatar corners">
            <Image class="portrait-img" src={asset('/sidhant.jpg')} alt="Sidhant Sardar" widths={[192, 384]} sizes="96px" loading="eager" />
          </div>
          <div class="intro-name">
            <b>Sidhant Sardar</b>
            <span>{tagline}</span>
            <span class="status mono"><i></i>Open to projects</span>
          </div>
        </div>
        <p class="eyebrow">Resume · 3.5+ years remote</p>
        <h1 class="cv-title"><span class="hard gt">{headline[0]}</span> <span class="soft gt">{headline[1]}</span></h1>
        <p class="cv-lead">{lead}</p>
        <div class="actions">
          <a class="btn primary" href="/sidhant-sardar-resume.pdf" download data-track="resume_download" data-track-format="pdf" data-track-location="resume">Download PDF <span class="ar">↓</span></a>
          <a class="btn" href="/sidhant-sardar-resume.docx" download data-track="resume_download" data-track-format="word" data-track-location="resume">Download Word <span class="ar">↓</span></a>
          <a class="btn" href="/">See my work <span class="ar">→</span></a>
        </div>
      </div>

      <aside class="loop glass" aria-labelledby="loop-h" data-reveal>
        <div class="loop-top">
          <h2 class="rs-k" id="loop-h">How I work</h2>
          <span class="loop-tag"><Icon name="repeat-2" size={14} />One loop</span>
        </div>
        <ol class="loop-steps">
          <li class="loop-rail" aria-hidden="true"></li>
          {loop.map((s) => (
            <li class="loop-step">
              <span class="loop-n"><Icon name={s.icon} size={19} /></span>
              <div class="loop-b">
                <h3>{s.k}</h3>
                <p>{s.line}</p>
                <ul class="tool-row" aria-label={`${s.k} tools`}>
                  {s.tools.map((t) => <li class="tool"><Icon name={toolset[t].icon} size={15} /><span>{toolset[t].name}</span></li>)}
                </ul>
              </div>
            </li>
          ))}
          <li class="loop-step again">
            <span class="loop-n"><Icon name="repeat-2" size={17} /></span>
            <p class="loop-b">{loopBack}</p>
          </li>
        </ol>
      </aside>

      <ul class="contact">
        {contacts.map((c) => (
          <li><a href={c.href} {...(c.key === 'email' || c.key === 'phone' ? { 'data-track': 'contact_click', 'data-track-method': c.key, 'data-track-location': 'resume' } : { target: '_blank', rel: 'noopener' })}>
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[c.key]}></svg><span>{c.label}</span>
          </a></li>
        ))}
      </ul>
    </header>

    <!-- Four numbers -->
    <ul class="glance glass" aria-label="At a glance" data-reveal>
      {glance.map((g) => (
        <li>
          <span class="g-i"><Icon name={g.icon} size={20} /></span>
          <b><span class="gt">{g.n}</span>{g.unit && <small>{g.unit}</small>}</b>
          <span class="g-l">{g.label}</span>
        </li>
      ))}
    </ul>

    <!-- Experience: the years as one bar, then a card per job -->
    <section class="rs-sec" aria-labelledby="exp-h">
      <h2 class="rs-h" id="exp-h"><Icon name="briefcase-business" size={16} /><span>Experience</span></h2>
      <div class="career" aria-hidden="true" data-reveal>
        {career.map((c) => (
          <>
            {c.gap > 0 && <div class="c-gap" style={`--m:${c.gap}`}><i></i></div>}
            <div class:list={['c-seg', { now: !c.j.end }]} style={`--m:${c.months}`}>
              <div class="c-years"><span>{c.j.start.slice(0, 4)}</span><span>{c.j.end ? c.j.end.slice(0, 4) : 'Now'}</span></div>
              <i class="c-bar"></i>
              <div class="c-l"><b>{c.role}</b><span>{c.org}</span></div>
            </div>
          </>
        ))}
      </div>

      <div class="jobs">
        {jobs.map((j, i) => {
          const card = jobCards[i];
          // "… for 50+ enterprises, including HSBC, MUFG and Infosys" → the line, and the names as chips
          const [about, names] = j.note.split(', including ');
          const clients = names ? names.split(/, | and /) : [];
          return (
            <article class:list={['job glass', { now: !j.end }]} data-reveal>
              <header class="job-top">
                <span class="job-mark" aria-hidden="true">{card.mark}</span>
                <div class="job-id">
                  <h3>{j.role}</h3>
                  <p>{j.org}{clients.length === 0 && ` · ${j.note}`}</p>
                </div>
                <ul class="job-meta">
                  {!j.end && <li class="pill">Current</li>}
                  <li><Icon name="calendar-days" size={14} />{fmt(j.start)} – {j.end ? fmt(j.end) : 'Present'}</li>
                  <li><Icon name="clock-3" size={14} />{span(j.start, j.end)}</li>
                  <li><Icon name="map-pin" size={14} />{j.where}</li>
                </ul>
              </header>
              {clients.length > 0 && (
                <div class="job-clients">
                  <p><Icon name="building-2" size={16} /><span>{about}</span></p>
                  <ul>{clients.map((c) => <li>{c}</li>)}</ul>
                </div>
              )}
              <div class="areas">
                {j.groups.map((g, k) => {
                  const a = card.areas[k];
                  const name = g.k || a.title;
                  return (
                    <section class:list={['area', { wide: a.wide }]}>
                      <header class="area-top">
                        <span class="ico-tile"><Icon name={a.icon} size={18} /></span>
                        <div class="area-id">
                          <h4>{name}</h4>
                          {a.sub && <p>{a.sub}</p>}
                        </div>
                        {a.tools && (
                          <ul class="tool-row" aria-label="Tools">
                            {a.tools.map((t) => <li class="tool"><Icon name={toolset[t].icon} size={15} /><span>{toolset[t].short ?? toolset[t].name}</span></li>)}
                          </ul>
                        )}
                      </header>
                      {a.items && (
                        <ul class="pts">
                          {a.items.map(([ic, text]) => <li><Icon name={ic} size={17} /><span>{text}</span></li>)}
                        </ul>
                      )}
                      {a.grid && (
                        <ul class="quad">
                          {a.grid.map(([ic, text]) => <li><Icon name={ic} size={18} /><span>{text}</span></li>)}
                        </ul>
                      )}
                      <details class="more">
                        <summary><span>Details<span class="vh">: {name}</span></span><Icon name="chevron-down" size={14} /></summary>
                        <ul class="full">{g.points.map((p) => <li set:html={kwHtml(p)} />)}</ul>
                      </details>
                    </section>
                  );
                })}
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <!-- Toolkit: every tool with its logo -->
    <section class="rs-sec" aria-labelledby="kit-h">
      <h2 class="rs-h" id="kit-h"><Icon name="wrench" size={16} /><span>Toolkit</span></h2>
      <ul class="kit" data-stagger>
        {toolkit.map((k) => (
          <li class="kit-t glass">
            <Icon name={toolset[k].icon} size={32} />
            <b>{toolset[k].name}</b>
            {toolset[k].note && <small>{toolset[k].note}</small>}
          </li>
        ))}
      </ul>
    </section>

    <!-- Core skills, grouped -->
    <section class="rs-sec" aria-labelledby="sk-h">
      <h2 class="rs-h" id="sk-h"><Icon name="layers" size={16} /><span>Core skills</span></h2>
      <div class="skills" data-stagger>
        {skills.filter((s) => s.k !== 'Tools & build').map((s) => (
          <article class="sk glass">
            <header><span class="ico-tile"><Icon name={skillIcons[s.k]} size={18} /></span><h3>{s.k}</h3></header>
            <ul class="tags">{s.v.map((v) => <li><ToolText text={v} size={13} /></li>)}</ul>
          </article>
        ))}
      </div>
    </section>

    <!-- Featured projects -->
    <section class="rs-sec" aria-labelledby="pj-h">
      <h2 class="rs-h" id="pj-h"><Icon name="layout-grid" size={16} /><span>Featured projects</span></h2>
      {projects.filter((p) => p.featured).map((p) => {
        const a = projectArt[p.name];
        return (
          <article class="pf glass" data-reveal>
            <div class="pf-copy">
              <span class="feat-tag mono">{p.featured}</span>
              <h3>{p.name}</h3>
              <p class="pf-type">{p.type}</p>
              <ul class="tags">{a.chips.map((c) => <li>{c}</li>)}</ul>
              <ul class="tool-row" aria-label="Tools">
                {a.tools.map((t) => <li class="tool"><Icon name={toolset[t].icon} size={15} /><span>{toolset[t].name}</span></li>)}
              </ul>
              <a class="card-link" href={p.caseStudy}>See the full product design process <span class="ar">→</span></a>
            </div>
            <div class="pf-art glow-card" aria-hidden="true"><WorkArt kind="product" /></div>
          </article>
        );
      })}
      <ul class="pgrid" data-stagger>
        {projects.filter((p) => !p.featured).map((p) => {
          const a = projectArt[p.name];
          return (
            <li class="pj glass">
              <span class="ico-tile"><Icon name={a.icon} size={18} /></span>
              <h3>{p.name}</h3>
              <p>{p.type}</p>
              <ul class="tool-row" aria-label="Tools">
                {a.tools.map((t) => <li class="tool"><Icon name={toolset[t].icon} size={15} /><span>{toolset[t].short ?? toolset[t].name}</span></li>)}
              </ul>
              <div class="pj-links">
                {a.page && <a class="link" href={a.page}>How I built it <span class="ar">→</span></a>}
                {p.url && <a class="link" href={p.url} target="_blank" rel="noopener">{host(p.url)} <Icon name="arrow-up-right" size={13} /></a>}
              </div>
            </li>
          );
        })}
      </ul>
    </section>

    <!-- What I bring, then education and links -->
    <section class="rs-sec" aria-labelledby="br-h">
      <h2 class="rs-h" id="br-h"><Icon name="sparkles" size={16} /><span>What I bring</span></h2>
      <ul class="brings" data-stagger>
        {bringsShort.map((b) => (
          <li class="glass">
            <span class="ico-tile"><Icon name={b.icon} size={18} /></span>
            <b>{b.k}</b>
            <p>{b.line}</p>
          </li>
        ))}
      </ul>
      <div class="tail" data-stagger>
        <section class="glass" aria-labelledby="edu-h">
          <span class="ico-tile"><Icon name="graduation-cap" size={18} /></span>
          <div>
            <h2 class="rs-k" id="edu-h">Education</h2>
            <b>{education.title}</b>
            <p>{education.org} · {education.year}</p>
          </div>
        </section>
        <section class="glass" aria-labelledby="ln-h">
          <span class="ico-tile"><Icon name="link" size={18} /></span>
          <div>
            <h2 class="rs-k" id="ln-h">Links</h2>
            <p class="cv-links">
              <a class="link" href="/">sidhantsardar.com</a>
              {projects.filter((p) => p.url && !p.url.includes('sidhantsardar')).map((p) => <a class="link" href={p.url} target="_blank" rel="noopener">{host(p.url)} <Icon name="arrow-up-right" size={13} /></a>)}
            </p>
          </div>
        </section>
      </div>
    </section>
  </div>

  <ResumeSheet />
</Base>

<style>
  /* This page's own tokens: tiles sit inside cards, chips sit inside tiles */
  .cv{--card-line:var(--line);--tile:#F7F7F8;--tile-line:var(--line);--chip:var(--surface);--chip-line:var(--line-2);--kw:rgba(0,0,255,.13);
    padding-block:40px 96px;display:grid;gap:clamp(52px,6.5vw,80px)}
  :global(:root[data-theme="dark"]) .cv{--card-line:rgba(255,255,255,.08);--tile:rgba(255,255,255,.035);--tile-line:rgba(255,255,255,.07);--chip:rgba(255,255,255,.05);--chip-line:rgba(255,255,255,.12);--kw:rgba(143,155,255,.3)}
  .vh{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
  ul,ol{list-style:none;margin:0;padding:0}

  /* ---------- header ---------- */
  .rs-head{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(0,.92fr);gap:32px clamp(32px,5vw,72px);align-items:center}
  .rs-id{display:grid;gap:16px;justify-items:start;min-width:0}
  .rs-id .intro-id{margin-bottom:12px}
  .cv-title{font-size:clamp(36px,4.5vw,64px);line-height:.98;letter-spacing:-.045em}
  .cv-title span{display:block}
  .cv-title .soft{color:var(--accent);max-width:17ch}
  .cv-lead{color:var(--muted);font-size:17px;line-height:1.55;max-width:50ch}
  .actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:8px}
  /* small label used inside cards */
  .rs-k{font-family:var(--mono);font-size:11px;font-weight:500;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin:0}

  /* "How I work": three lit steps on one line, and the way back to the start */
  .loop{padding:clamp(18px,2.4vw,26px);display:grid;gap:20px}
  /* dark theme: a little blue light in the card's top corner, and on the lit steps */
  :global(:root[data-theme="dark"]) .loop{background:radial-gradient(90% 70% at 100% 0%,rgba(92,104,255,.16),transparent 62%),linear-gradient(180deg,rgba(255,255,255,.055),rgba(255,255,255,.02))}
  :global(:root[data-theme="dark"]) .loop-step:not(.again) .loop-n{background:linear-gradient(180deg,#4652FF,#2632F0);box-shadow:inset 0 1px 0 rgba(255,255,255,.3),0 8px 18px -10px rgba(46,59,255,.9)}
  :global(:root[data-theme="dark"]) .loop-step.again .loop-n{background:#0C0C10}
  .loop-top{display:flex;justify-content:space-between;align-items:center;gap:12px}
  .loop-tag{display:inline-flex;align-items:center;gap:6px;padding:4px 10px 4px 8px;border-radius:999px;background:var(--accent-soft);color:var(--accent);font-family:var(--mono);font-size:11px}
  .loop-steps{position:relative;display:grid}
  /* the line behind the steps, with a light that runs down it */
  .loop-rail{position:absolute;left:19px;top:20px;bottom:16px;width:2px;border-radius:2px;background-color:var(--line-2);
    background-image:linear-gradient(transparent,var(--accent),transparent);background-size:100% 64px;background-repeat:no-repeat;background-position:0 -64px;animation:loopRun 3.6s linear infinite}
  @keyframes loopRun{to{background-position:0 calc(100% + 64px)}}
  .loop-step{position:relative;display:grid;grid-template-columns:40px minmax(0,1fr);gap:0 16px;align-items:start;padding-bottom:22px}
  .loop-step:last-child{padding-bottom:0}
  .loop-n{width:40px;height:40px;border-radius:12px;display:grid;place-items:center;background:var(--accent-fill);color:var(--on-accent)}
  .loop-b h3{font-size:19px;line-height:1.1;letter-spacing:-.02em;padding-top:2px}
  .loop-b p{color:var(--muted);font-size:14px;margin-top:3px}
  .loop-step.again{align-items:center}
  .loop-step.again .loop-n{width:32px;height:32px;margin-left:4px;border-radius:50%;background:var(--bg);border:1px solid var(--line-2);color:var(--accent)}
  p.loop-b{color:var(--muted);font-size:14px}

  /* a tool: its logo and its name */
  .tool-row{display:flex;flex-wrap:wrap;gap:6px}
  .loop .tool-row{margin-top:10px}
  .tool{display:inline-flex;align-items:center;gap:6px;padding:5px 10px 5px 8px;border-radius:999px;border:1px solid var(--chip-line);background:var(--chip);font-size:12.5px;line-height:1.2;white-space:nowrap}
  /* a plain tag */
  .tags{display:flex;flex-wrap:wrap;gap:6px}
  .tags li{padding:5px 10px;border-radius:999px;border:1px solid var(--chip-line);background:var(--chip);color:var(--muted);font-size:12.5px;line-height:1.2}

  /* contact chips: one row under both columns */
  .contact{grid-column:1/-1;display:flex;flex-wrap:wrap;gap:8px;padding-top:24px;border-top:1px solid var(--line)}
  .contact a{display:inline-flex;align-items:center;gap:8px;padding:8px 14px 8px 11px;border:1px solid var(--chip-line);border-radius:999px;background:var(--chip);text-decoration:none;font-size:14px;line-height:1.2;transition:border-color .2s,color .2s}
  .contact a:hover{border-color:var(--accent);color:var(--accent)}
  .contact svg{width:16px;height:16px;flex:none;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}

  /* ---------- four numbers ---------- */
  .glance{display:grid;grid-template-columns:repeat(4,minmax(0,1fr))}
  .glance li{display:grid;gap:8px;align-content:start;padding:clamp(18px,2.2vw,26px)}
  .glance li+li{border-left:1px solid var(--card-line)}
  .g-i{color:var(--accent);display:flex}
  .glance b{font-family:var(--display);font-size:clamp(34px,3.8vw,52px);font-weight:700;line-height:1;letter-spacing:-.045em}
  .glance small{margin-left:5px;font-size:.36em;font-weight:500;letter-spacing:0;color:var(--muted)}
  .g-l{color:var(--muted);font-size:13.5px;line-height:1.4}

  /* ---------- sections ---------- */
  .rs-sec{display:grid;gap:22px}
  .rs-h{display:flex;align-items:center;gap:10px;font-family:var(--mono);font-size:12px;font-weight:500;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
  .rs-h :global(.ico){color:var(--accent)}
  .rs-h::after{content:"";flex:1;height:1px;margin-left:6px;background:linear-gradient(90deg,var(--line-2),transparent)}

  /* the years as one bar: each job as wide as it lasted, the current one in blue */
  .career{display:flex;align-items:flex-start;gap:6px}
  .c-seg,.c-gap{flex:var(--m) 1 0;min-width:0;display:grid;grid-template-rows:16px 6px auto;gap:8px}
  .c-years{display:flex;justify-content:space-between;font-family:var(--mono);font-size:11px;line-height:16px;color:var(--dim)}
  .c-bar{display:block;border-radius:6px;background:var(--line-2)}
  .c-seg.now .c-bar{position:relative;background:linear-gradient(90deg,var(--accent-fill),var(--accent))}
  .c-seg.now .c-bar::after{content:"";position:absolute;right:-2px;top:50%;width:12px;height:12px;margin-top:-6px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 4px var(--accent-soft)}
  .c-gap i{grid-row:2;align-self:center;height:0;border-top:2px dotted var(--line-2)}
  .c-l{display:grid;gap:1px;font-size:13.5px;line-height:1.3}
  .c-l b{font-weight:600}
  .c-l span{color:var(--muted);font-size:12.5px}

  /* ---------- a job ---------- */
  .jobs{display:grid;gap:20px}
  .job{padding:clamp(16px,2.4vw,28px);display:grid;gap:18px}
  .job-top{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:14px 16px;align-items:center}
  .job-mark{width:48px;height:48px;border-radius:14px;display:grid;place-items:center;border:1px solid var(--chip-line);background:var(--tile);font-family:var(--display);font-size:21px;font-weight:700;letter-spacing:-.03em}
  .job.now .job-mark{background:var(--accent-fill);border-color:transparent;color:var(--on-accent)}
  :global(:root[data-theme="dark"]) .job.now .job-mark{background:linear-gradient(180deg,#4652FF,#2632F0);box-shadow:inset 0 1px 0 rgba(255,255,255,.3),0 8px 18px -10px rgba(46,59,255,.9)}
  .job-id h3{font-size:clamp(19px,2vw,24px);line-height:1.15;letter-spacing:-.025em}
  .job-id p{color:var(--muted);font-size:15px;margin-top:4px}
  .job-meta{display:flex;flex-wrap:wrap;gap:6px;justify-content:flex-end}
  .job-meta li{display:inline-flex;align-items:center;gap:6px;padding:5px 10px 5px 8px;border-radius:999px;border:1px solid var(--chip-line);background:var(--chip);color:var(--muted);font-family:var(--mono);font-size:11.5px;line-height:1.3;white-space:nowrap}
  .job-meta .pill{padding-left:10px;background:var(--accent-fill);border-color:transparent;color:var(--on-accent)}
