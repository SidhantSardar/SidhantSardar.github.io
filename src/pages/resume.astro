---
// Resume as a web page: share the link instead of a PDF. The PDF and Word downloads are made from the
// same text (src/data/resume.mjs) by `npm run resume:files`.
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { asset } from '../data/images';
import { EMAIL, PHONE, PHONE_TEL, LINKEDIN, YOUTUBE } from '../data/profile';
import { skills, jobs, projects, brings, fmt, span, tagline, headline, profile, education } from '../data/resume.mjs';

---
<Base active="resume" title="Resume · Sidhant Sardar" description="Sidhant Sardar: UI/UX designer, Webflow developer and AI-assisted developer (Claude Code). 3.5+ years of remote product and web design." image="/sidhant-full.jpg" imageAlt="Sidhant Sardar">
  <div class="in cv">
    <header class="cv-head">
      <div class="intro-id">
        <div class="avatar corners">
          <Image class="portrait-img" src={asset('/sidhant.jpg')} alt="Sidhant Sardar" widths={[192, 384]} sizes="96px" loading="eager" />
          <span class="dims">96 × 112</span>
        </div>
        <div class="intro-name">
          <b>Sidhant Sardar</b>
          <span>{tagline}</span>
          <span class="status mono"><i></i>Open to projects</span>
        </div>
      </div>
      <p class="eyebrow">Resume · 3.5+ years remote</p>
      <h1 class="cv-title">{headline[0]} <span class="soft">{headline[1]}</span></h1>
      <ul class="contact">
        <li><a href={`mailto:${EMAIL}`} data-track="contact_click" data-track-method="email" data-track-location="resume">{EMAIL}</a></li>
        {PHONE && <li><a href={`tel:${PHONE_TEL}`} data-track="contact_click" data-track-method="phone" data-track-location="resume">{PHONE}</a></li>}
        <li><a href="/">sidhantsardar.com</a></li>
        {LINKEDIN && <li><a href={LINKEDIN} target="_blank" rel="noopener">linkedin.com/in/sidhant-sardar</a></li>}
        {YOUTUBE && <li><a href={YOUTUBE} target="_blank" rel="noopener">{YOUTUBE.replace(/^https?:\/\/(www\.)?/, '')}</a></li>}
      </ul>
      <div class="actions no-print">
        <a class="btn primary" href="/sidhant-sardar-resume.pdf" download data-track="resume_download" data-track-format="pdf" data-track-location="resume">Download PDF <span class="ar">↓</span></a>
        <a class="btn" href="/sidhant-sardar-resume.docx" download data-track="resume_download" data-track-format="word" data-track-location="resume">Download Word <span class="ar">↓</span></a>
        <a class="btn" href="/">See my work <span class="ar">→</span></a>
      </div>
    </header>

    <div class="cv-grid">
      <div class="main">
        <section>
          <h2 class="eyebrow">Profile</h2>
          <p class="lead">{profile}</p>
        </section>

        <section class="panel exp">
          <h2 class="eyebrow">Experience</h2>
          <ol class="timeline">
            {jobs.map((j) => (
              <li class:list={['tl', { now: !j.end }]}>
                <div class="tl-when">
                  <b>{j.start.slice(0, 4)} – {j.end ? j.end.slice(0, 4) : 'Now'}</b>
                  <span>{fmt(j.start)} – {j.end ? fmt(j.end) : 'Present'}</span>
                  <span>{span(j.start, j.end)} · {j.where}</span>
                  {!j.end && <span class="pill">Current</span>}
                </div>
                <span class="tl-dot" aria-hidden="true"></span>
                <div class="tl-body">
                  <h3>{j.role}</h3>
                  <p class="org"><b>{j.org}</b> · {j.note}</p>
                  {j.groups.map((g) => (
                    <div class="grp">
                      {g.k && <span class="grp-k mono">{g.k}</span>}
                      <ul>{g.points.map((p) => <li>{p}</li>)}</ul>
                    </div>
                  ))}
                </div>
              </li>
            ))}
          </ol>
        </section>

        <section class="panel proj">
          <h2 class="eyebrow">Featured projects</h2>
          <div class="projects">
            {projects.map((p) => (
              <article>
                <h3>{p.name} <span class="muted">· {p.type}</span></h3>
                <span class="mono muted">{p.role}</span>
                <p>{p.body}</p>
                {p.url && <a class="mono" href={p.url} target="_blank" rel="noopener">{p.url.replace('https://', '')} ↗</a>}
              </article>
            ))}
          </div>
        </section>
      </div>

      <aside class="side panel">
        <section>
          <h2 class="eyebrow">Core skills</h2>
          {skills.map((s) => (
            <div class="skill"><b>{s.k}</b><p>{s.v.join(' · ')}</p></div>
          ))}
        </section>
        <section>
          <h2 class="eyebrow">What I bring</h2>
          <ul class="brings">{brings.map((b) => <li>{b}</li>)}</ul>
        </section>
        <section>
          <h2 class="eyebrow">Education</h2>
          <p><b>{education.title}</b><br /><span class="muted">{education.org} · {education.year}</span></p>
        </section>
        <section>
          <h2 class="eyebrow">Links</h2>
          <p class="cv-links"><a href="/">Portfolio · sidhantsardar.com</a><a href="https://aligne.ai" target="_blank" rel="noopener">aligne.ai ↗</a></p>
        </section>
      </aside>
    </div>
  </div>
</Base>


<style>
  .cv{padding-block:56px 96px;display:grid;gap:40px;--t-exp:#F6F6F3;--t-proj:#F2F5F8;--t-side:#F7F5F1}
  :global(:root[data-theme="dark"]) .cv{--t-exp:#101010;--t-proj:#0C0F13;--t-side:#13110E}
  .panel{border-radius:14px;padding:clamp(18px,3vw,28px)}
  .exp{background:var(--t-exp)}
  .proj{background:var(--t-proj)}
  .side.panel{background:var(--t-side);align-self:start}
  .timeline{list-style:none;margin:0;padding:0;display:grid;gap:28px;position:relative}
  .timeline::before{content:"";position:absolute;left:172px;top:8px;bottom:8px;width:1px;background:var(--line-2)}
  .tl{display:grid;grid-template-columns:150px 44px 1fr;align-items:start}
  .tl-when{display:grid;gap:3px;justify-items:start}
  .tl-when b{font-family:var(--display);font-size:20px;letter-spacing:-.02em;line-height:1.1}
  .tl-when span{font-family:var(--mono);font-size:11px;color:var(--muted)}
  .pill{margin-top:6px;padding:2px 8px;border-radius:999px;background:var(--ink);color:var(--bg)!important}
  .tl-dot{justify-self:center;margin-top:6px;width:11px;height:11px;border-radius:50%;background:var(--bg);border:2px solid var(--ink);position:relative;z-index:1}
  .tl.now .tl-dot{background:var(--ink);box-shadow:0 0 0 4px var(--accent-soft)}
  .tl-body{display:grid;gap:8px;min-width:0}
  .grp{display:grid;gap:4px;margin-top:4px}
  .grp-k{font-size:10.5px;text-transform:uppercase;letter-spacing:.08em;color:var(--dim)}
  .grp ul{margin:0;padding-left:18px;display:grid;gap:5px;font-size:15px;color:var(--muted)}
  @media (max-width:720px){
    .contact{display:grid;gap:0}
    .contact a{display:inline-flex;align-items:center;min-height:44px;border-bottom:0;text-decoration:underline;text-decoration-color:var(--line-2);text-underline-offset:5px}
    .projects a,.cv-links a{display:inline-flex;align-items:center;min-height:44px}
    .projects h3 span{display:block;margin-top:2px}
    .actions .btn{flex:1;justify-content:center}
  }
  @media (max-width:640px){.timeline::before{left:5px}.tl{grid-template-columns:22px 1fr}.tl-dot{grid-row:1;grid-column:1;justify-self:start;margin-top:5px}.tl-when{grid-column:2;margin-bottom:10px}.tl-body{grid-column:2}}
  .cv-head{display:grid;gap:18px;border-bottom:1px solid var(--line);padding-bottom:28px}
  .intro-id{margin-bottom:22px}
  .cv-title{font-size:clamp(36px,4.6vw,66px);line-height:.98;max-width:16ch}
  .cv-title .soft{color:var(--dim)}
  .contact{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:6px 20px;font-size:15px}
  .contact a{text-decoration:none;border-bottom:1px solid var(--line-2)}
  .contact a:hover{border-color:var(--ink)}
  .actions{display:flex;gap:10px;flex-wrap:wrap}
  .cv-grid{display:grid;grid-template-columns:1fr 320px;gap:56px}
  .main,.side{display:grid;gap:40px;align-content:start}
  section{display:grid;gap:14px;align-content:start}
  .lead{font-size:17px;line-height:1.6;color:var(--muted)}
  .job{display:grid;gap:8px;padding-bottom:22px}
  .job+.job{border-top:1px solid var(--line);padding-top:22px}
  .job-top{display:flex;justify-content:space-between;gap:8px 16px;flex-wrap:wrap;align-items:baseline}
  h3{font-size:19px;letter-spacing:-.015em}
  .org{font-size:15px;color:var(--muted)}
  .org b{color:var(--ink);font-weight:600}
  .job ul,.brings{margin:4px 0 0;padding-left:18px;display:grid;gap:6px;font-size:15px;color:var(--muted)}
  .projects{display:grid;gap:20px}
  .projects article{display:grid;gap:6px;border-top:1px solid var(--line);padding-top:14px}
  .projects h3 span{font-weight:400;font-size:15px}
  .projects p{font-size:15px;color:var(--muted)}
  .projects a{text-decoration:none;justify-self:start}
  .skill{display:grid;gap:4px;border-top:1px solid var(--line);padding-top:10px}
  .skill b{font-size:14.5px;font-weight:600}
  .skill p{font-size:14px;color:var(--muted);line-height:1.55}
  .side p{font-size:15px}
  .cv-links{display:grid;gap:6px;justify-items:start;text-align:left}
  .cv-links a{text-decoration:none}
  @media (max-width:860px){.cv-grid{grid-template-columns:1fr;gap:40px}}

  /* Print / Save as PDF: plain A4, black on white, no site chrome */
  @media print{
    @page{size:A4;margin:14mm 14mm}
    :global(html),:global(body){background:#fff!important;color:#111!important}
    :global(nav),:global(footer),:global(.grid-overlay),:global(.skip),:global(.cursor),.no-print{display:none!important}
    .cv{padding:0 1mm!important}
    :global(*){color:#111!important;transition:none!important;animation:none!important;opacity:1!important;transform:none!important}
    .cv{padding:0;gap:18px;font-size:12px}
    .cv-head{padding-bottom:12px;gap:10px}
    .intro-id{margin-bottom:4px;gap:14px}
    .avatar{width:58px;height:68px}
    .avatar .dims{display:none}
    .intro-name .status{font-size:9.5px!important;margin-top:1px}
    .intro-name b{font-size:18px}
    .intro-name>span{font-size:11.5px!important}
    .cv-title{font-size:24px;max-width:none}
    .cv-title .soft{color:#666!important}
    .contact{font-size:11.5px}
    .cv-grid{grid-template-columns:1fr 220px;gap:24px}
    .main,.side{gap:16px}
    section{gap:8px}
    .lead,.job ul,.brings,.projects p,.side p,.skill p,.org{font-size:11px;line-height:1.45}
    h3{font-size:13.5px}
    .job{padding-bottom:10px;gap:4px;break-inside:avoid}
    .job+.job{padding-top:10px}
    .projects{gap:8px}
    .projects article{padding-top:8px;gap:3px;break-inside:avoid}
    a{text-decoration:none!important;border:0!important}
    @page{margin:11mm 12mm}
    .cv{gap:12px}
    .mono,.eyebrow{font-size:9px!important}
    .skill b,.org b{font-size:11.5px}
    .projects h3 span{font-size:11px}
    .job ul,.brings{gap:2px;margin-top:2px}
    .skill{padding-top:6px;gap:2px}
    .side{gap:12px}
    .cv-links{gap:2px;font-size:11px}
    .lead{font-size:11px}
    .lead,.job ul,.brings,.projects p,.org{font-size:10.5px!important;line-height:1.4!important}
    .main{gap:12px}
    .job{padding-bottom:6px}
    .job+.job{padding-top:6px}
    .panel{padding:10px 12px;border-radius:8px;-webkit-print-color-adjust:exact;print-color-adjust:exact}
    .timeline{gap:10px}
    .timeline::before{left:96px}
    .tl{grid-template-columns:84px 24px 1fr}
    .tl-when b{font-size:13px}
    .tl-when span{font-size:8.5px!important}
    .pill{color:#fff!important;padding:1px 6px}
    .tl-dot{width:8px;height:8px;margin-top:3px}
    .tl-body{gap:3px}
    .grp{gap:1px;margin-top:1px}
    .grp-k{font-size:8px!important}
    .grp ul{font-size:10.2px!important;line-height:1.38;gap:1px}
    /* Two clean pages: profile + experience on page 1, projects on page 2 */
    .proj{break-before:page}
    .side section{break-inside:avoid}
    .tl{break-inside:avoid}
  }
</style>
