---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CaseCard from '../components/CaseCard.astro';
import Gap from '../components/Gap.astro';
import JsonLd from '../components/JsonLd.astro';
import Capabilities from '../components/Capabilities.astro';
import { Image } from 'astro:assets';
import { asset } from '../data/images';
import { LINKEDIN, YOUTUBE, CV, EMAIL, PHONE, PHONE_TEL, AVAILABILITY } from '../data/profile';
import { skills } from '../data/skills';

const SITE = 'https://www.sidhantsardar.com/';
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${SITE}#person`,
    name: 'Sidhant Sardar',
    jobTitle: 'Web designer and Webflow developer',
    url: SITE,
    image: `${SITE}sidhant.jpg`,
    email: `mailto:${EMAIL}`,
    ...(PHONE_TEL ? { telephone: PHONE_TEL } : {}),
    // Only skills that have a proof page on the site
    knowsAbout: skills.filter((s) => s.status === 'shown').map((s) => s.label),
    ...(LINKEDIN || YOUTUBE ? { sameAs: [LINKEDIN, YOUTUBE].filter(Boolean) } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE}#website`,
    name: 'Sidhant Sardar',
    url: SITE,
    publisher: { '@id': `${SITE}#person` },
  },
];

const sites = [
  {
    slug: 'altrum-website', n: '01', name: 'AltrumAI', url: 'https://www.aligne.ai/altrum/', domain: 'aligne.ai/altrum',
    line: 'Product pages for an enterprise AI control platform. Built first in Webflow, now in code.',
    chips: ['Webflow', 'Astro', 'Messaging'], shot: '/sites/altrum.jpg', measure: '1440 desktop',
  },
  {
    slug: 'aligne-ai', n: '02', name: 'Aligne AI', url: 'https://www.aligne.ai/', domain: 'aligne.ai',
    line: 'Responsible AI consultancy. Moved from Webflow to code, with a CMS the sales team publishes from.',
    chips: ['Astro', 'Cloudflare', 'Pages CMS'], shot: '/sites/aligne.jpg', measure: 'CMS · 4 collections',
  },
  {
    slug: 'world-of-gears', n: '03', name: 'World of Gears', url: 'https://www.worldofgears.com/', domain: 'worldofgears.com',
    line: 'Sustainability consultancy working across 17 countries.',
    chips: ['Webflow', 'CMS', 'Content'], shot: '/sites/wog.jpg', measure: 'CMS · 3 collections',
  },
];

// Home "Work" section: three picks. The full list lives on /work/.
const workEntries = await getCollection('work');
const pick = (id: string) => workEntries.find((w) => w.id === id)!;
const totalWork = workEntries.length + (await getCollection('portfolio')).length + 1;
const featuredWork = [
  {
    href: '/work/altrum-product-design/', label: 'Product design · Client project', process: true,
    title: 'Designing an AI governance product, end to end',
    line: 'The Altrum AI web app: domain, colours, layouts, user flows, every screen, Figma Make prototypes, build follow-up and testing.',
    tags: ['Product design', 'Figma', 'UX'],
  },
  { href: '/work/altrum-website/', label: 'Website · Client project', title: pick('altrum-website').data.title, line: pick('altrum-website').data.summary, cover: pick('altrum-website').data.cover, tags: ['Webflow', 'Code'] },
  { href: '/work/world-of-gears/', label: 'Website · Client project', title: pick('world-of-gears').data.title, line: pick('world-of-gears').data.summary, cover: pick('world-of-gears').data.cover, tags: ['Webflow', 'CMS'] },
];

// Services are hidden for now (they'll get their own page). Flip to true to show them again.
const SHOW_SERVICES = false;
const services = [
  {
    n: '01', name: 'Website design + build',
    line: 'Figma design, then a Webflow build with the CMS, SEO and analytics set up. Your team publishes pages, blogs and events without waiting on a developer, and you see which pages bring in enquiries.',
    chips: ['Figma', 'Webflow', 'CMS', 'SEO', 'Analytics'], ref: 'Built for World of Gears, AltrumAI and Aligne AI',
  },
  {
    n: '02', name: 'Websites in code',
    line: 'The same design quality, built in Astro and hosted on Cloudflare. You own the code, and your team edits content in a simple Git-based CMS.',
    chips: ['Astro', 'Cloudflare', 'Git CMS'], ref: 'Built for Aligne AI and AltrumAI',
  },
  {
    n: '03', name: 'Figma to Webflow builds',
    line: 'For agencies and designers with more designs than build time. Send me the Figma file and I build it in Webflow to the pixel, with the CMS wired up for your client.',
    chips: ['Webflow', 'White-label'], ref: 'For agencies and studios',
  },
  {
    n: '04', name: 'Product UX in Figma',
    line: 'Web app flows, design systems with variables and light/dark modes, and handoff files developers can build from without extra meetings.',
    chips: ['Figma', 'Design systems', 'Prototypes'], ref: 'The AltrumAI web app, since 2023',
  },
];
---
<Base active="home">
  <JsonLd data={schema} />
  <!-- HERO + ABOUT: who I am, the moment the page opens -->
  <header class="hero" id="about">
    <div class="in">
      <div class="intro">
        <span class="spec" data-reveal>Frame / Hero · <b>1240 × 720</b> · H1 <b>66/64</b></span>
        <p class="eyebrow hero-eyebrow" data-reveal>Designed in Figma · Built in Webflow or code</p>
        <h1 data-split>Websites for B2B consultancies <span class="soft">and AI companies</span></h1>
        <p class="hero-sub" data-reveal>With a monthly dashboard that shows which pages bring in clients.</p>
        <p class="lede" data-reveal>I design the site, build it with a CMS your marketing and sales people update themselves, and set up the tracking behind the dashboard. One person does all of it, so what ships matches what you signed off.</p>
        <div class="facts" data-stagger>
          <div><b>2023 →</b><span>AltrumAI web app UX in Figma</span></div>
          <div><b data-count="3">3</b><span>Websites, in Webflow and code</span></div>
          <div><b class="accent">Code</b><span>Astro sites on Cloudflare</span></div>
        </div>
        <div class="cta" data-reveal>
          <a class="btn primary magnetic" href="#contact" data-track="cta_click" data-track-cta="start_project" data-track-location="hero">Start a project <span class="ar">↓</span></a>
          <a class="btn magnetic" href="#work" data-track="cta_click" data-track-cta="see_work" data-track-location="hero">See my work <span class="ar">↓</span></a>
        </div>
      </div>
      <figure class="hero-photo" data-reveal>
        <div class="hero-portrait corners" data-portrait>
          <Image class="portrait-img" src={asset('/sidhant.jpg')} alt="Sidhant Sardar at his desk" widths={[440, 660, 800]} sizes="(max-width: 900px) 260px, 440px" loading="eager" fetchpriority="high" />
          <span class="dims">440 × 550</span>
        </div>
        <figcaption>
          <b>Sidhant Sardar</b>
          <span class="status mono"><i></i>Open to projects</span>
        </figcaption>
      </figure>
    </div>
  </header>

  <Gap size={120} />

  <!-- WORK: three picks, the rest on /work/ -->
  <section id="work">
    <div class="in">
      <div class="section-head">
        <span class="spec" data-reveal>Section / Work · <b>3 of {totalWork}</b> · 3 col · gap <b>20</b></span>
        <h2 data-split>Work</h2>
        <p data-reveal>Product design for an AI web app, and websites for AI and sustainability companies.</p>
      </div>
      <div class="case-grid three" data-stagger>
        {featuredWork.map((w) => <CaseCard {...w} heading="h3" />)}
      </div>
      <div class="section-foot" data-reveal><a class="btn primary magnetic" href="/work/">View all work <span class="ar">→</span></a></div>
    </div>
  </section>

  <Gap size={120} />

  <!-- WEBSITES -->
  <section id="websites">
    <div class="in">
      <div class="section-head">
        <span class="spec" data-reveal>Section / Websites · <b>3 items</b> · 3 col · gap <b>20</b></span>
        <h2 data-split>Websites</h2>
        <p data-reveal>Marketing sites for AI and sustainability companies, built in Webflow and in code.</p>
      </div>
      <div class="case-grid three" data-stagger>
        {sites.map((s) => (
          <article class="case site-card">
            <a class="mini media" href={`/work/${s.slug}/`} tabindex="-1" aria-hidden="true">
              <Image src={asset(s.shot)} alt="" widths={[400, 640, 900]} sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 400px" />
            </a>
            <div class="case-body">
              <span class="n">{s.n} / 03 · {s.domain}</span>
              <h3>{s.name}</h3>
              <p>{s.line}</p>
              <div class="chips">{s.chips.map((c) => <span class="chip">{c}</span>)}</div>
              <div class="site-links">
                <a class="link-arrow" href={`/work/${s.slug}/`}>How I built it <span class="ar">→</span></a>
                <a class="link-arrow" href={s.url} target="_blank" rel="noopener">Visit site <span class="ar">↗</span></a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Gap size={120} />

  <!-- SERVICES: hidden for now (SHOW_SERVICES) -->
  {SHOW_SERVICES && (
    <section id="services">
      <div class="in">
        <div class="section-head">
          <span class="spec" data-reveal>Section / Services · <b>4 offers</b> · gap <b>24</b></span>
          <h2 data-split>Services</h2>
          <p data-reveal>Tell me what you need, and you get a fixed quote before any work starts.</p>
        </div>
        <div class="services" data-stagger>
          {services.map((s) => (
            <article class="service">
              <span class="n">{s.n}</span>
              <h3>{s.name}</h3>
              <p>{s.line}</p>
              <div class="chips">{s.chips.map((c) => <span class="chip">{c}</span>)}</div>
              <span class="ref">{s.ref}</span>
            </article>
          ))}
        </div>
        <p class="services-note" data-reveal>Already have a site? I also take on ongoing work: new pages, CMS changes and fixes.</p>
      </div>
    </section>
  )}
  {SHOW_SERVICES && <Gap size={120} />}

  <!-- CAPABILITIES: every skill links to its proof -->
  <Capabilities />

  <Gap size={120} />

  <!-- WEB APP -->
  <section id="web-app">
    <div class="in">
      <div class="section-head">
        <span class="spec" data-reveal>Section / Figma experience · <b>2023 → now</b></span>
        <h2 data-split>The AltrumAI web app</h2>
      </div>
      <div class="app-card corners" data-reveal>
        <div class="app-top">
          <div>
            <h3>One place for a company to see, check and control every AI system it uses.</h3>
            <p>I've designed its UX and UI in Figma since 2023: onboarding, guided risk assessments, configuration, dashboards and the design system behind them.</p>
          </div>
          <a class="btn primary magnetic" href="/portfolio">See UX case studies <span class="ar">→</span></a>
        </div>
        <div class="pipeline" id="pipeline">
          <div class="pipe">
            <span class="flowdot"></span><div class="node"><svg viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="3"/><path d="M8 9h8M8 13h8M8 17h5"/></svg></div>
            <b>Register</b><span>List every AI system in use</span>
          </div>
          <div class="pipe">
            <span class="flowdot"></span><div class="node"><svg viewBox="0 0 24 24"><path d="M5 6h14v9H9l-4 4z"/><path d="M9 10h6"/></svg></div>
            <b>Assess</b><span>Answer a guided risk check</span>
          </div>
          <div class="pipe">
            <span class="flowdot"></span><div class="node"><svg viewBox="0 0 24 24"><path d="M12 3l7 3v6c0 4-3 7-7 9-4-2-7-5-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg></div>
            <b>Control</b><span>Apply guardrails and policies</span>
          </div>
          <div class="pipe">
            <span class="flowdot"></span><div class="node"><svg viewBox="0 0 24 24"><path d="M4 19V5M4 19h16"/><path d="M8 15l3-4 3 2 4-6"/></svg></div>
            <b>Monitor</b><span>Track usage, cost and risk</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Gap size={96} />

  <!-- CONTACT -->
  <div class="in" id="contact">
    <div class="contact">
      <span class="spec" data-reveal>Section / Contact</span>
      <h2 data-split>Let's design something that ships.</h2>
      <p data-reveal>Send a few lines: what you're building, a link to your current site, and when you need it live.</p>
      <div class="mail"><a href={`mailto:${EMAIL}`} style="text-decoration:none" data-track="contact_click" data-track-method="email" data-track-location="contact"><code>{EMAIL}</code></a><button id="copy" type="button" aria-label="Copy email address" data-email={EMAIL} data-track="contact_click" data-track-method="copy_email" data-track-location="contact">Copy</button></div>
      {PHONE && (
        <div class="mail"><a href={`tel:${PHONE_TEL}`} style="text-decoration:none" data-track="contact_click" data-track-method="phone" data-track-location="contact"><code>{PHONE}</code></a></div>
      )}
      <p class="avail">{AVAILABILITY}</p>
      {(LINKEDIN || CV) && (
        <div class="contact-links">
          {LINKEDIN && <a class="link-arrow" href={LINKEDIN} target="_blank" rel="noopener">LinkedIn <span class="ar">↗</span></a>}
          {YOUTUBE && <a class="link-arrow" href={YOUTUBE} target="_blank" rel="noopener">YouTube <span class="ar">↗</span></a>}
          {CV && <a class="link-arrow" href={CV}>Resume <span class="ar">→</span></a>}
        </div>
      )}
    </div>
  </div>
</Base>

<script>
  document.getElementById('copy')!.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    try { await navigator.clipboard.writeText(btn.dataset.email ?? ''); btn.textContent = 'Copied'; }
    catch { btn.textContent = 'Select it'; }
    setTimeout(() => (btn.textContent = 'Copy'), 1800);
  });
</script>
