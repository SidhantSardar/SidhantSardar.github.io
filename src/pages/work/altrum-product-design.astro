---
// Product design case study for the Altrum AI web app: the whole process, step by step.
// Real screens stay private, so every picture here is a simplified diagram (components/StepArt.astro).
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import JsonLd from '../../components/JsonLd.astro';
import StepArt from '../../components/StepArt.astro';
import { EMAIL } from '../../data/profile';

const deepDives = (await getCollection('portfolio')).sort((a, b) => a.data.order - b.data.order);

const steps = [
  {
    n: '01', title: 'Understand the product and the domain', art: 'domain',
    did: ['Learned how AI governance works: policies, risk, audits and incidents.', 'Worked out who uses each part: compliance, risk and technical teams.', 'Turned requirements from the team into a clear list of what each screen must do.'],
    out: 'A shared picture of the product before any design starts.',
  },
  {
    n: '02', title: 'Set the visual foundations', art: 'palette',
    did: ['Researched colour for a product that must feel calm, secure and trustworthy.', 'Chose the colour palette and the accent colour.', 'Set the type scale, spacing and the first components in Figma.'],
    out: 'A visual language the whole product is built on.',
  },
  {
    n: '03', title: 'Research the layouts', art: 'layouts',
    did: ['Studied layouts for data-heavy B2B products: tables, dashboards, split views.', 'Picked a layout for each job: scanning lists, reading detail, taking action.', 'Kept navigation the same everywhere so users never get lost.'],
    out: 'A layout system that fits dense information without feeling crowded.',
  },
  {
    n: '04', title: 'Map the user flows and confirm them', art: 'flow',
    did: ['Mapped each flow: the main path, the edge cases and what happens on errors.', 'Defined the interaction logic: what every button does and where it leads.', 'Walked stakeholders through the flows and confirmed them before designing screens.'],
    out: 'Agreed flows, so screens are designed once, not redesigned.',
  },
  {
    n: '05', title: 'Design every screen and state', art: 'screens',
    did: ['Designed every screen in Figma on the shared design system.', 'Covered every state: default, empty, loading and error.', 'Built data-rich dashboards for policies, risk, audit logs and incidents.'],
    out: 'A complete, consistent product in Figma, ready to prototype.',
  },
  {
    n: '06', title: 'Prototype and demonstrate', art: 'prototype',
    did: ['Built clickable prototypes in Figma Make.', 'Demonstrated them to the team lead and the core developers.', 'Collected feedback and adjusted the design before build.'],
    out: 'Developers see exactly how it should work, not just how it looks.',
  },
  {
    n: '07', title: 'Follow up through the build', art: 'check',
    did: ['Stayed with developers during the build to answer questions.', 'Followed up to check the built screens match the design.', 'Flagged gaps in spacing, states and components early.'],
    out: 'What ships matches what was designed.',
  },
  {
    n: '08', title: 'Test and improve', art: 'loop',
    did: ['Tested the live web app end to end, flow by flow.', 'Noted usability issues and observations.', 'Turned them into design fixes for the next release.'],
    out: 'A product that keeps getting easier to use.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: 'Altrum AI web app: product design, end to end',
  description: 'How I designed an AI-powered B2B SaaS product end to end: domain, visual foundations, layouts, user flows, screens, prototypes, build follow-up and testing.',
  url: new URL('/work/altrum-product-design/', Astro.site).href,
  creator: { '@id': new URL('/#person', Astro.site).href },
  keywords: 'Product design, UI/UX, Figma, Figma Make, Claude Code, AI governance, B2B SaaS',
};
---
<Base title="Altrum AI web app · Product design · Sidhant Sardar" description="How I designed an AI-powered B2B SaaS product end to end: domain, colours, layouts, user flows, every screen, Figma Make prototypes, build follow-up and testing." active="work">
  <JsonLd data={schema} />
  <div class="in">
    <header class="page-head">
      <a class="back" href="/work/">← Work</a>
      <span class="spec">Case study / Product design · <b>Figma · Figma Make · Claude Code</b> · <span class="kind">Client project</span></span>
      <span class="eyebrow">Altrum AI web app · AI-powered B2B SaaS</span>
      <h1>Designing an AI governance product, end to end.</h1>
      <p class="sum">Altrum AI helps enterprises and Tier-1 banks govern their AI. I designed the whole web app: from learning the domain and choosing the colours, to mapping every flow, prototyping it and checking the build.</p>
      <div class="snap">
        <div><span>Product</span><b>AI-powered B2B SaaS</b></div>
        <div><span>Users</span><b>Compliance, risk and technical teams</b></div>
        <div><span>My role</span><b>Product designer (UI/UX)</b></div>
        <div><span>Timeline</span><b>2023 → now</b></div>
      </div>
    </header>

    <p class="pd-note">The real screens stay private, so this page shows <b>how I work</b>, step by step, with simplified diagrams.</p>

    <figure class="fig">
      <div class="canvas">
        <div class="flow pd-flow">
          {steps.map((s, i) => (
            <>
              {i > 0 && <span class="ar">→</span>}
              <a class={`st pd-jump ${i === 0 ? 'acc' : ''}`} href={`#step-${s.n}`}><span class="k">Step {s.n}</span><b>{s.title.split(' ').slice(0, 3).join(' ')}</b></a>
            </>
          ))}
        </div>
      </div>
      <figcaption><b>Fig 1</b>The process, from understanding the product to improving it after launch. Click a step to jump to it.</figcaption>
    </figure>

    <!-- The eight steps as one story. A line runs down the middle and fills as you scroll; each step
         hangs off it, text on one side and its picture on the other, swapping sides every step.
         On phones the line moves to the left edge and each step stacks: title, picture, text. -->
    <div class="pd-story" data-story>
      <div class="story-line" aria-hidden="true"><i class="story-fill"></i></div>
      {steps.map((s) => (
        <section class="story-step pd-step" id={`step-${s.n}`} aria-labelledby={`h-${s.n}`}>
          <div class="pd-head">
            <span class="mono pd-k">Step {s.n} <i>/ {String(steps.length).padStart(2, '0')}</i></span>
            <h2 id={`h-${s.n}`}>{s.title}</h2>
          </div>
          <span class="story-node pd-node" aria-hidden="true">{s.n}</span>
          <div class="pd-art glow-card" aria-hidden="true"><StepArt kind={s.art} /></div>
          <div class="pd-body">
            <ul>{s.did.map((d) => <li>{d}</li>)}</ul>
            <p class="pd-out"><span class="mono">Result</span>{s.out}</p>
          </div>
        </section>
      ))}
    </div>

    <section class="pd-ai" aria-labelledby="ai-h">
      <span class="eyebrow">How AI fits in</span>
      <h2 id="ai-h">From design to a working prototype, faster</h2>
      <p>With <b>Figma Make</b> and <b>Claude Code</b> I can turn the Figma designs into working prototypes quickly. The team can click through real flows earlier, and developers start from something that already behaves the way it should.</p>
    </section>

    <section class="pd-deep" aria-labelledby="deep-h">
      <span class="eyebrow">Deep dives</span>
      <h2 id="deep-h">Six problems from the product, one by one</h2>
      <div class="deep-grid">
        {deepDives.map((c) => (
          <a href={`/portfolio/${c.id}/`}><span class="mono">UX case study {String(c.data.order).padStart(2, '0')}</span><b>{c.data.title}</b><span class="ar">→</span></a>
        ))}
      </div>
    </section>

    <section class="case-cta" aria-labelledby="cta-h">
      <h2 id="cta-h">Need a product designer?</h2>
      <p>I design B2B products end to end, from flows and screens to the design system, and I can build the website too.</p>
      <div class="row">
        <a class="btn primary" href={`mailto:${EMAIL}?subject=${encodeURIComponent('Product design (from the Altrum AI case study)')}`} data-track="contact_click" data-track-method="email" data-track-location="case_study_altrum_product">Email me <span class="ar">→</span></a>
        <a class="btn" href="/resume/">See my resume <span class="ar">→</span></a>
      </div>
    </section>

    <div class="next">
      <span class="eyebrow">Next</span>
      <a href="/work/altrum-website/"><span class="eyebrow">Website · Client project</span><b>The Altrum AI website →</b></a>
    </div>
  </div>
</Base>

<style>
  .pd-note{border:1px solid var(--line-2);border-radius:10px;padding:14px 16px;color:var(--muted);font-size:15px;max-width:76ch;margin:8px 0 32px}
  .pd-note b{color:var(--ink);font-weight:600}
  .pd-jump{text-decoration:none;transition:border-color .2s}
  .pd-jump:hover{border-color:var(--accent)}
  /* Fig 1: on a desktop all eight steps fit on one line, so nothing hides behind a scroll */
  @media (min-width:1200px){
    .pd-flow{min-width:0;width:100%}
    .pd-flow .st{flex:1 1 0;width:auto;min-width:0;padding:12px}
    .pd-flow .st b{font-size:13.5px;overflow-wrap:anywhere}
    .pd-flow .ar{flex:none;width:22px}
  }

  /* ---------- the story ----------
     --node: size of the numbered dot on the line. --cg: space between the line and each side. */
  .pd-story{--node:48px;--cg:clamp(24px,3.4vw,48px);position:relative;display:grid;gap:clamp(72px,9vw,128px);margin:64px 0 112px;padding-block:24px}
  /* the line: grey, fading in at the top and out at the bottom; the blue fill grows over it on scroll */
  .story-line{position:absolute;left:50%;top:0;bottom:0;width:2px;margin-left:-1px;border-radius:2px;
    background:linear-gradient(transparent,var(--line-2) 90px,var(--line-2) calc(100% - 90px),transparent)}
  .story-fill{position:absolute;inset:0;border-radius:2px;transform-origin:top;opacity:0;
    background:linear-gradient(transparent,var(--accent-fill) 90px,var(--accent) calc(100% - 90px),transparent)}
  .pd-story.is-live .story-fill{opacity:1}

  .pd-step{display:grid;grid-template-columns:minmax(0,1fr) var(--node) minmax(0,1fr);grid-template-rows:auto auto;column-gap:var(--cg);row-gap:18px;
    grid-template-areas:"head node art" "body node art";align-items:center;scroll-margin-top:96px}
  .pd-step:nth-of-type(even){grid-template-areas:"art node head" "art node body"}
  .pd-head{grid-area:head;align-self:end;display:grid;gap:10px}
  .pd-body{grid-area:body;align-self:start}
  .pd-k{color:var(--accent);font-size:11.5px;letter-spacing:.1em;text-transform:uppercase}
  .pd-k i{color:var(--dim)}
  .pd-head h2{font-size:clamp(26px,3vw,40px);line-height:1.04;letter-spacing:-.035em}
  .pd-body ul{list-style:none;margin:0;padding:0;display:grid;gap:12px}
  .pd-body li{position:relative;padding-left:28px;color:var(--muted);font-size:16.5px;line-height:1.5}
  .pd-body li::before{content:"";position:absolute;left:0;top:.72em;width:14px;height:2px;border-radius:2px;background:var(--accent)}
  /* the result of a step: what it hands to the next one */
  .pd-out{margin-top:22px;display:grid;gap:5px;padding:14px 18px;border-radius:12px;border:1px solid color-mix(in srgb,var(--accent) 26%,transparent);
    background:var(--accent-soft);color:var(--ink);font-size:16.5px;font-weight:500;line-height:1.4}
  .pd-out .mono{color:var(--accent);font-size:10.5px;letter-spacing:.12em;text-transform:uppercase}

  /* the numbered dot on the line, and the short wire from it to the picture */
  .pd-node{grid-area:node;justify-self:center;position:relative;z-index:1;width:var(--node);height:var(--node);border-radius:50%;display:grid;place-items:center;
    border:1px solid var(--line-2);background:var(--bg);font-family:var(--mono);font-size:12.5px;color:var(--muted);
    transition:background-color .4s,border-color .4s,color .4s,box-shadow .4s}
  .pd-node::after{content:"";position:absolute;top:50%;left:100%;width:var(--cg);height:2px;margin-top:-1px;background:var(--line-2);transition:background-color .4s}
  .pd-node::before{content:"";position:absolute;z-index:1;top:50%;left:calc(100% + var(--cg) - 6px);width:12px;height:12px;margin-top:-6px;border-radius:50%;
    border:2px solid var(--line-2);background:var(--bg);transition:border-color .4s,box-shadow .4s}
  .pd-step:nth-of-type(even) .pd-node::after{left:auto;right:100%}
  .pd-step:nth-of-type(even) .pd-node::before{left:auto;right:calc(100% + var(--cg) - 6px)}
  /* reached: the dot fills blue and its wire lights up (scripts/motion.ts adds "on") */
  .pd-step.on .pd-node{background:var(--accent-fill);border-color:var(--accent-fill);color:var(--on-accent);box-shadow:0 0 0 6px var(--accent-soft)}
  .pd-step.on .pd-node::after{background:var(--accent)}
  .pd-step.on .pd-node::before{border-color:var(--accent)}

  /* the picture panel */
  .pd-art{grid-area:art;position:relative;aspect-ratio:4/3;border:1px solid var(--line);border-radius:18px;overflow:hidden;
    background:var(--bg-2) radial-gradient(circle,var(--line) 1px,transparent 1.2px) 0 0/18px 18px}
  .pd-art :global(.wa){position:absolute;inset:0;padding:clamp(8px,2.4%,18px)}

  /* dark theme: the line and the dots glow */
  :global(:root[data-theme="dark"]) .story-fill{background:linear-gradient(transparent,#2E3BFF 90px,#8F9BFF calc(100% - 90px),transparent);filter:drop-shadow(0 0 4px rgba(143,155,255,.5))}
  :global(:root[data-theme="dark"]) .pd-node{background:#0B0B0F;border-color:rgba(255,255,255,.2)}
  :global(:root[data-theme="dark"]) .pd-step.on .pd-node{background:linear-gradient(180deg,#4652FF,#2632F0);border-color:#7A84FF;box-shadow:0 0 0 6px rgba(46,59,255,.16),0 10px 22px -10px rgba(46,59,255,.85),inset 0 1px 0 rgba(255,255,255,.3)}
  :global(:root[data-theme="dark"]) .pd-step.on .pd-node::after{background:#8F9BFF;box-shadow:0 0 8px rgba(143,155,255,.4)}
  :global(:root[data-theme="dark"]) .pd-node::before{background:#0B0B0F}
  :global(:root[data-theme="dark"]) .pd-step.on .pd-node::before{border-color:#8F9BFF;box-shadow:0 0 8px rgba(143,155,255,.4)}
  :global(:root[data-theme="dark"]) .pd-out{background:linear-gradient(180deg,rgba(92,104,255,.2),rgba(92,104,255,.08));border-color:rgba(143,155,255,.34)}

  .pd-ai{display:grid;gap:12px;max-width:68ch;margin-bottom:64px}
  .pd-ai h2,.pd-deep h2{font-size:clamp(24px,2.8vw,32px)}
  .pd-ai p{color:var(--muted);font-size:17px}
  .pd-ai b{color:var(--ink);font-weight:600}
  .pd-deep{display:grid;gap:14px;margin-bottom:56px}
  .deep-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px}
  .deep-grid a{display:grid;grid-template-columns:1fr auto;gap:4px 12px;align-items:center;text-decoration:none;border:1px solid var(--line);border-radius:10px;padding:14px 16px;background:var(--surface);transition:border-color .2s,box-shadow .3s}
  .deep-grid a:hover{border-color:var(--accent)}
  .deep-grid .mono{grid-column:1;color:var(--dim);font-size:10.5px}
  .deep-grid b{grid-column:1;font-size:15.5px}
  .deep-grid .ar{grid-column:2;grid-row:1/3;color:var(--accent)}
  :global(:root[data-theme="dark"]) .deep-grid a{background:linear-gradient(180deg,#131318,#0B0B0F);border-color:rgba(255,255,255,.1)}
  :global(:root[data-theme="dark"]) .deep-grid a:hover{border-color:#6B76FF;box-shadow:0 18px 36px -26px rgba(46,59,255,.7)}

  /* phones and small tablets: one column, the line down the left edge */
  @media (max-width:899px){
    .pd-story{--node:36px;gap:64px;margin:48px 0 80px;padding-block:8px}
    .story-line{left:calc(var(--node) / 2)}
    .pd-step,.pd-step:nth-of-type(even){grid-template-columns:var(--node) minmax(0,1fr);column-gap:16px;row-gap:18px;grid-template-areas:"node head" "art art" ". body";align-items:start}
    .pd-head{align-self:center}
    .pd-node{font-size:11.5px}
    .pd-node::before,.pd-node::after{display:none}
    .pd-art{max-width:560px;width:100%}
    .pd-body li{font-size:16px}
  }
</style>
