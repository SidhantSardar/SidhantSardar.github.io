---
// Product design case study for the Altrum AI web app: the whole process, step by step.
// Real screens stay private, so every picture here is a simplified diagram.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import JsonLd from '../../components/JsonLd.astro';
import { EMAIL } from '../../data/profile';

const deepDives = (await getCollection('portfolio')).sort((a, b) => a.data.order - b.data.order);

const steps = [
  {
    n: '01', title: 'Understand the product and the domain', art: 'domain',
    did: ['Learned how AI governance works: policies, risk, audits and incidents.', 'Worked out who uses each part: compliance, risk and technical teams.', 'Turned requirements from the team into a clear list of what each screen must do.'],
    out: 'A shared picture of the product before any design starts.',
  },
  {
    n: '02', title: 'Set the visual foundations', art: 'palette',
    did: ['Researched colour for a product that must feel calm, secure and trustworthy.', 'Chose the colour palette and the accent colour.', 'Set the type scale, spacing and the first components in Figma.'],
    out: 'A visual language the whole product is built on.',
  },
  {
    n: '03', title: 'Research the layouts', art: 'layouts',
    did: ['Studied layouts for data-heavy B2B products: tables, dashboards, split views.', 'Picked a layout for each job: scanning lists, reading detail, taking action.', 'Kept navigation the same everywhere so users never get lost.'],
    out: 'A layout system that fits dense information without feeling crowded.',
  },
  {
    n: '04', title: 'Map the user flows and confirm them', art: 'flow',
    did: ['Mapped each flow: the main path, the edge cases and what happens on errors.', 'Defined the interaction logic: what every button does and where it leads.', 'Walked stakeholders through the flows and confirmed them before designing screens.'],
    out: 'Agreed flows, so screens are designed once, not redesigned.',
  },
  {
    n: '05', title: 'Design every screen and state', art: 'screens',
    did: ['Designed every screen in Figma on the shared design system.', 'Covered every state: default, empty, loading and error.', 'Built data-rich dashboards for policies, risk, audit logs and incidents.'],
    out: 'A complete, consistent product in Figma, ready to prototype.',
  },
  {
    n: '06', title: 'Prototype and demonstrate', art: 'prototype',
    did: ['Built clickable prototypes in Figma Make.', 'Demonstrated them to the team lead and the core developers.', 'Collected feedback and adjusted the design before build.'],
    out: 'Developers see exactly how it should work, not just how it looks.',
  },
  {
    n: '07', title: 'Follow up through the build', art: 'check',
    did: ['Stayed with developers during the build to answer questions.', 'Followed up to check the built screens match the design.', 'Flagged gaps in spacing, states and components early.'],
    out: 'What ships matches what was designed.',
  },
  {
    n: '08', title: 'Test and improve', art: 'loop',
    did: ['Tested the live web app end to end, flow by flow.', 'Noted usability issues and observations.', 'Turned them into design fixes for the next release.'],
    out: 'A product that keeps getting easier to use.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: 'Altrum AI web app: product design, end to end',
  description: 'How I designed an AI-powered B2B SaaS product end to end: domain, visual foundations, layouts, user flows, screens, prototypes, build follow-up and testing.',
  url: new URL('/work/altrum-product-design/', Astro.site).href,
  creator: { '@id': new URL('/#person', Astro.site).href },
  keywords: 'Product design, UI/UX, Figma, Figma Make, Claude Code, AI governance, B2B SaaS',
};
---
<Base title="Altrum AI web app · Product design · Sidhant Sardar" description="How I designed an AI-powered B2B SaaS product end to end: domain, colours, layouts, user flows, every screen, Figma Make prototypes, build follow-up and testing." active="work">
  <JsonLd data={schema} />
  <div class="in">
    <header class="page-head">
      <a class="back" href="/work/">← Work</a>
      <span class="spec">Case study / Product design · <b>Figma · Figma Make · Claude Code</b> · <span class="kind">Client project</span></span>
      <span class="eyebrow">Altrum AI web app · AI-powered B2B SaaS</span>
      <h1>Designing an AI governance product, end to end.</h1>
      <p class="sum">Altrum AI helps enterprises and Tier-1 banks govern their AI. I designed the whole web app: from learning the domain and choosing the colours, to mapping every flow, prototyping it and checking the build.</p>
      <div class="snap">
        <div><span>Product</span><b>AI-powered B2B SaaS</b></div>
        <div><span>Users</span><b>Compliance, risk and technical teams</b></div>
        <div><span>My role</span><b>Product designer (UI/UX)</b></div>
        <div><span>Timeline</span><b>2023 → now</b></div>
      </div>
    </header>

    <p class="pd-note">The real screens stay private, so this page shows <b>how I work</b>, step by step, with simplified diagrams.</p>

    <figure class="fig">
      <div class="canvas">
        <div class="flow">
          {steps.map((s, i) => (
            <>
              {i > 0 && <span class="ar">→</span>}
              <a class={`st pd-jump ${i === 0 ? 'acc' : ''}`} href={`#step-${s.n}`}><span class="k">Step {s.n}</span><b>{s.title.split(' ').slice(0, 3).join(' ')}</b></a>
            </>
          ))}
        </div>
      </div>
      <figcaption><b>Fig 1</b>The process, from understanding the product to improving it after launch. Click a step to jump to it.</figcaption>
    </figure>

    <div class="pd-steps">
      {steps.map((s) => (
        <section class="pd-step" id={`step-${s.n}`} aria-labelledby={`h-${s.n}`}>
          <div class="pd-text">
            <span class="mono pd-n">Step {s.n}</span>
            <h2 id={`h-${s.n}`}>{s.title}</h2>
            <ul>{s.did.map((d) => <li>{d}</li>)}</ul>
            <p class="pd-out"><span class="mono">Result</span>{s.out}</p>
          </div>
          <div class={`pd-art art-${s.art}`} aria-hidden="true">
            {s.art === 'domain' && (
              <div class="dom">
                <b>Product</b>
                {['Policies', 'Risk', 'Audits', 'Incidents', 'Users & roles', 'Reports'].map((x) => <span>{x}</span>)}
              </div>
            )}
            {s.art === 'palette' && (
              <div class="pal">
                <div class="sw-row">{['#0A0A0A', '#525252', '#8A8A8A', '#D4D4D4', '#F4F4F4'].map((c) => <i style={`background:${c}`}></i>)}</div>
                <div class="sw-acc"><i></i><span>Accent</span></div>
                <div class="type"><b>Aa</b><span>Type scale · 32 / 24 / 16 / 13</span></div>
                <small class="mono">Illustrative palette</small>
              </div>
            )}
            {s.art === 'layouts' && (
              <div class="lays">
                <div class="lay l-table"><i></i><div><em></em><em></em><em></em><em></em></div></div>
                <div class="lay l-cards"><i></i><div><em></em><em></em><em></em><em></em></div></div>
                <div class="lay l-split"><i></i><div><em></em><em></em></div></div>
              </div>
            )}
            {s.art === 'flow' && (
              <div class="uflow">
                <div class="row"><span>Start</span><s>→</s><span>Choose</span><s>→</s><span>Review</span><s>→</s><span class="ok">Confirm</span></div>
                <div class="row sub"><span class="edge e1">Edit ↺</span><span class="edge e2">Error ⚠</span></div>
                <p class="mono">✓ Confirmed with stakeholders</p>
              </div>
            )}
            {s.art === 'screens' && (
              <div class="screens">
                {['Default', 'Empty', 'Loading', 'Error'].map((x) => <div class={`scr s-${x.toLowerCase()}`}><div class="bar"></div><div class="body"></div><span class="mono">{x}</span></div>)}
              </div>
            )}
            {s.art === 'prototype' && (
              <div class="proto">
                <div class="frame"><div class="bar"></div><div class="btn-x">Button</div><span class="tap"></span></div>
                <span class="arr">→</span>
                <div class="who"><b>Demo</b><span>Team lead</span><span>Core developers</span></div>
              </div>
            )}
            {s.art === 'check' && (
              <ul class="checks">
                {['Matches the design', 'Every state built', 'Spacing and components right', 'Interaction logic works'].map((x) => <li><i>✓</i>{x}</li>)}
              </ul>
            )}
            {s.art === 'loop' && (
              <div class="loop">
                <span>Test</span><s>→</s><span>Note</span><s>→</s><span>Fix</span><s class="back-ar">↺</s>
              </div>
            )}
          </div>
        </section>
      ))}
    </div>

    <section class="pd-ai" aria-labelledby="ai-h">
      <span class="eyebrow">How AI fits in</span>
      <h2 id="ai-h">From design to a working prototype, faster</h2>
      <p>With <b>Figma Make</b> and <b>Claude Code</b> I can turn the Figma designs into working prototypes quickly. The team can click through real flows earlier, and developers start from something that already behaves the way it should.</p>
    </section>

    <section class="pd-deep" aria-labelledby="deep-h">
      <span class="eyebrow">Deep dives</span>
      <h2 id="deep-h">Six problems from the product, one by one</h2>
      <div class="deep-grid">
        {deepDives.map((c) => (
          <a href={`/portfolio/${c.id}/`}><span class="mono">UX case study {String(c.data.order).padStart(2, '0')}</span><b>{c.data.title}</b><span class="ar">→</span></a>
        ))}
      </div>
    </section>

    <section class="case-cta" aria-labelledby="cta-h">
      <h2 id="cta-h">Need a product designer?</h2>
      <p>I design B2B products end to end, from flows and screens to the design system, and I can build the website too.</p>
      <div class="row">
        <a class="btn primary" href={`mailto:${EMAIL}?subject=${encodeURIComponent('Product design (from the Altrum AI case study)')}`} data-track="contact_click" data-track-method="email" data-track-location="case_study_altrum_product">Email me <span class="ar">→</span></a>
        <a class="btn" href="/resume/">See my resume <span class="ar">→</span></a>
      </div>
    </section>

    <div class="next">
      <span class="eyebrow">Next</span>
      <a href="/work/altrum-website/"><span class="eyebrow">Website · Client project</span><b>The Altrum AI website →</b></a>
    </div>
  </div>
</Base>

<style>
  .pd-note{border:1px solid var(--line-2);border-radius:10px;padding:14px 16px;color:var(--muted);font-size:15px;max-width:76ch;margin:8px 0 32px}
  .pd-note b{color:var(--ink);font-weight:600}
  .pd-jump{text-decoration:none;transition:border-color .2s}
  .pd-jump:hover{border-color:var(--ink)}
  .pd-steps{display:grid;gap:20px;margin:40px 0 72px}
  .pd-step{display:grid;grid-template-columns:1.1fr 1fr;gap:40px;align-items:center;border:1px solid var(--line);border-radius:14px;padding:clamp(20px,3vw,32px);scroll-margin-top:90px}
  .pd-text{display:grid;gap:12px}
  .pd-n{color:var(--dim)}
  .pd-text h2{font-size:clamp(22px,2.4vw,28px)}
  .pd-text ul{margin:0;padding-left:18px;display:grid;gap:6px;color:var(--muted);font-size:15.5px}
  .pd-out{display:grid;gap:2px;border-top:1px solid var(--line);padding-top:12px;font-size:15px}
  .pd-out .mono{color:var(--dim)}
  .pd-art{border-radius:12px;background:var(--bg-2);min-height:220px;display:grid;place-items:center;padding:24px;
    background-image:radial-gradient(circle,var(--line) 1px,transparent 1.2px);background-size:18px 18px}

  /* 01 domain map */
  .dom{display:grid;grid-template-columns:repeat(3,auto);gap:10px;justify-items:center}
  .dom b{grid-column:1/-1;padding:8px 16px;border-radius:8px;background:var(--ink);color:var(--bg);font-size:14px}
  .dom span{padding:6px 12px;border-radius:999px;border:1px solid var(--line-2);background:var(--surface);font-size:13px}
  /* 02 palette */
  .pal{display:grid;gap:12px;justify-items:start}
  .sw-row{display:flex;gap:6px}.sw-row i{width:38px;height:38px;border-radius:8px;border:1px solid rgba(0,0,0,.06)}
  .sw-acc{display:flex;gap:10px;align-items:center;font-size:13px}.sw-acc i{width:84px;height:30px;border-radius:8px;background:var(--accent-fill)}
  .type{display:flex;gap:12px;align-items:baseline}.type b{font-size:34px;letter-spacing:-.03em}.type span{font-size:12.5px;color:var(--muted)}
  .pal small{color:var(--dim);font-size:10.5px}
  /* 03 layouts */
  .lays{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;width:100%}
  .lay{aspect-ratio:4/3;border:1px solid var(--line-2);border-radius:8px;background:var(--surface);display:grid;grid-template-columns:18% 1fr;gap:6px;padding:6px}
  .lay i{background:var(--line);border-radius:4px}
  .lay div{display:grid;gap:4px}.lay em{background:var(--bg-2);border-radius:3px;border:1px solid var(--line)}
  .l-cards div{grid-template-columns:1fr 1fr}
  .l-split div{grid-template-columns:1fr 1.4fr}
  /* 04 flow */
  .uflow{display:grid;gap:10px;justify-items:start}
  .uflow .row{display:grid;grid-template-columns:72px 18px 72px 18px 72px 18px 72px;align-items:center}
  .uflow span{font-size:12px;text-align:center;padding:7px 4px;border:1px solid var(--line-2);border-radius:6px;background:var(--surface)}
  .uflow span.ok{background:var(--accent-fill);color:var(--on-accent);border-color:var(--accent-fill)}
  .uflow span.edge{border-style:dashed;color:var(--muted)}
  .uflow .e1{grid-column:5}.uflow .e2{grid-column:7}
  .uflow s{text-decoration:none;text-align:center;color:var(--dim);font-size:12px}
  .uflow p{font-size:11.5px;color:var(--accent)}
  /* 05 screens */
  .screens{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;width:100%}
  .scr{display:grid;grid-template-rows:10px 1fr auto;gap:5px;aspect-ratio:3/4;border:1px solid var(--line-2);border-radius:8px;background:var(--surface);padding:6px}
  .scr .bar{background:var(--line);border-radius:3px}
  .scr .body{border-radius:4px;background:repeating-linear-gradient(var(--bg-2) 0 8px,transparent 8px 13px)}
  .s-empty .body{background:var(--bg-2)}
  .s-loading .body{background:linear-gradient(90deg,var(--bg-2),var(--line),var(--bg-2))}
  .s-error .body{background:var(--bg-2);border:1px dashed var(--ink)}
  .scr .mono{font-size:9.5px;color:var(--muted);text-align:center}
  /* 06 prototype */
  .proto{display:flex;align-items:center;gap:16px}
  .proto .frame{position:relative;width:120px;height:160px;border:1px solid var(--line-2);border-radius:12px;background:var(--surface);padding:8px;display:grid;grid-template-rows:10px 1fr;gap:8px}
  .proto .bar{background:var(--line);border-radius:3px}
  .proto .btn-x{align-self:end;justify-self:center;font-size:10px;padding:5px 12px;border-radius:6px;background:var(--accent-fill);color:var(--on-accent)}
  .proto .tap{position:absolute;bottom:14px;left:50%;width:22px;height:22px;margin-left:8px;border-radius:50%;border:2px solid var(--accent);background:var(--accent-soft)}
  .proto .arr{color:var(--dim)}
  .proto .who{display:grid;gap:6px}.proto .who b{font-size:13px}
  .proto .who span{font-size:12px;padding:5px 10px;border:1px solid var(--line-2);border-radius:999px;background:var(--surface)}
  /* 07 checks */
  .checks{list-style:none;margin:0;padding:0;display:grid;gap:8px}
  .checks li{display:flex;gap:10px;align-items:center;font-size:14px;padding:8px 12px;border:1px solid var(--line-2);border-radius:8px;background:var(--surface)}
  .checks i{font-style:normal;width:20px;height:20px;border-radius:50%;display:grid;place-items:center;background:var(--accent-fill);color:var(--on-accent);font-size:11px}
  /* 08 loop */
  .loop{display:flex;align-items:center;gap:10px}
  .loop span{padding:10px 16px;border:1px solid var(--line-2);border-radius:999px;background:var(--surface);font-weight:500}
  .loop s{text-decoration:none;color:var(--dim)}
  .loop .back-ar{font-size:20px}

  .pd-ai{display:grid;gap:12px;max-width:68ch;margin-bottom:64px}
  .pd-ai h2,.pd-deep h2{font-size:clamp(24px,2.8vw,32px)}
  .pd-ai p{color:var(--muted);font-size:17px}
  .pd-ai b{color:var(--ink);font-weight:600}
  .pd-deep{display:grid;gap:14px;margin-bottom:56px}
  .deep-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px}
  .deep-grid a{display:grid;grid-template-columns:1fr auto;gap:4px 12px;align-items:center;text-decoration:none;border:1px solid var(--line);border-radius:10px;padding:14px 16px;transition:border-color .2s}
  .deep-grid a:hover{border-color:var(--ink)}
  .deep-grid .mono{grid-column:1;color:var(--dim);font-size:10.5px}
  .deep-grid b{grid-column:1;font-size:15.5px}
  .deep-grid .ar{grid-column:2;grid-row:1/3;color:var(--dim)}

  @media (max-width:860px){.pd-step{grid-template-columns:minmax(0,1fr);gap:24px}.pd-text,.pd-art{min-width:0}}
  @media (max-width:520px){
    .lays,.screens{grid-template-columns:1fr 1fr}
    .pd-art{padding:16px;overflow:hidden}
    .uflow .row{grid-template-columns:54px 12px 54px 12px 54px 12px 54px}
    .uflow span{font-size:10.5px;padding:6px 2px}
    .uflow s{font-size:10px}
    .dom{grid-template-columns:repeat(2,auto)}
    .sw-row i{width:32px;height:32px}
    .proto{flex-direction:column}
    .loop{flex-wrap:wrap;justify-content:center}
    .proto .arr{transform:rotate(90deg)}
  }
</style>
