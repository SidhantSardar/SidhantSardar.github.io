---
// Work = what I built: the product first, then the websites (same list as the home page).
// Case studies (the detailed decisions) live on /portfolio/.
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';
import ToolText from '../../components/ToolText.astro';
import { work, alsoBuilt } from '../../data/work';

const isThisSite = (url: string) => url.includes('sidhantsardar.com');
---
<Base title="Work · Sidhant Sardar" description="What I've built: the Altrum AI web app (product design), the Aligne AI website (Webflow, then Claude Code) and the World of Gears website (Webflow)." active="work">
  <section class="sub-hero">
    <div class="in">
      <header class="page-head">
        <h1>Work</h1>
        <p class="sum">What I've built. The product I designed comes first, then the websites. Each one shows how I built it.</p>
      </header>
    </div>
  </section>
  <div class="in">

    <div class="case-grid three work-grid">
      {work.map((w) => <WorkCard {...w} heading="h2" />)}
    </div>

    <section class="also" aria-labelledby="also-h">
      <h2 id="also-h" class="eyebrow">Also built</h2>
      <ul>
        {alsoBuilt.map((a) => (
          <li>
            <div class="also-name"><b>{a.name}</b><span>{a.type}</span></div>
            <span class="also-role"><ToolText text={a.role} /></span>
            {isThisSite(a.url)
              ? <span class="mono muted also-here">You're on it</span>
              : <a class="link-arrow" href={a.url} target="_blank" rel="noopener">Visit site <span class="ar">↗</span></a>}
          </li>
        ))}
      </ul>
    </section>

    <section class="to-cases" aria-labelledby="cases-h">
      <div>
        <span class="eyebrow">Case studies</span>
        <h2 id="cases-h">Want the decisions behind the work?</h2>
        <p>Case studies go deep on one problem at a time: the options, the trade-offs and why I chose what I did. Six of them come from the Altrum AI web app.</p>
      </div>
      <a class="btn primary" href="/portfolio">See the case studies <span class="ar">→</span></a>
    </section>
    <div style="height:80px"></div>
  </div>
</Base>

<style>
  .also{margin-top:56px;display:grid;gap:12px}
  .also ul{list-style:none;margin:0;padding:0;border-top:1px solid var(--line)}
  .also li{display:grid;grid-template-columns:minmax(220px,1.1fr) 1.4fr auto;gap:8px 24px;align-items:center;padding:16px 0;border-bottom:1px solid var(--line)}
  .also-name{display:grid;gap:2px}
  .also-name b{font-size:17px}
  .also-name span,.also-role{color:var(--muted);font-size:14.5px}
  .also-here{font-size:11.5px}
  .to-cases{margin-top:56px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:20px 40px;border:1px solid var(--line);border-radius:14px;padding:clamp(20px,3vw,32px);background:var(--bg-2)}
  .to-cases div{display:grid;gap:8px;max-width:62ch}
  .to-cases h2{font-size:clamp(22px,2.6vw,30px)}
  .to-cases p{color:var(--muted);font-size:16px}
  @media (max-width:760px){.also li{grid-template-columns:1fr;gap:6px}}
</style>
