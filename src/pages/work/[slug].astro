---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import JsonLd from '../../components/JsonLd.astro';
import { Image } from 'astro:assets';
import { asset } from '../../data/images';
import { skills as allSkills } from '../../data/skills';
import { EMAIL, PHONE, PHONE_TEL } from '../../data/profile';

export async function getStaticPaths() {
  const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return work.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: work[(i + 1) % work.length] },
  }));
}

const { entry, next } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const shownSkills = d.skills.map((id) => allSkills.find((s) => s.id === id)).filter((s) => s !== undefined);

// Structured data: tells search engines this page is a project made by the Person on the home page.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: d.title,
  description: d.summary,
  url: new URL(`/work/${entry.id}/`, Astro.site).href,
  creator: { '@id': new URL('/#person', Astro.site).href },
  keywords: d.stack,
  ...(d.cover ? { image: new URL(d.cover, Astro.site).href } : {}),
  ...(d.url ? { sameAs: d.url } : {}),
};
---
<Base active="work" title={`${d.title} · Sidhant Sardar`} description={d.summary} image={d.cover} imageAlt={`Screenshot of the ${d.eyebrow.split(' · ')[0]} website`}>
  <JsonLd data={schema} />
  <div class="in">
    <header class="page-head">
      <a class="back" href="/work/">← Work</a>
      <span class="spec">Case study / Website · <b>{d.stack}</b> · <span class={`kind ${d.kind}`}>{d.kind === 'client' ? 'Client project' : 'Practice project'}</span></span>
      <span class="eyebrow">{d.eyebrow}</span>
      <h1>{d.title}</h1>
      <p class="sum">{d.summary}</p>
      <div class="snap">{d.snapshot.map((s) => <div><span>{s.label}</span><b>{s.value}</b></div>)}</div>
      {shownSkills.length > 0 && (
        <div class="chips skills-shown"><span class="mono muted">Skills shown</span>{shownSkills.map((s) => <a class="chip" href={`/#skill-${s.id}`}>{s.label}</a>)}</div>
      )}
    </header>

    {d.coverMobile && d.cover && (
      <figure class="fig devices">
        <Image src={asset(d.cover)} alt={`${d.title}: desktop, 1440 wide`} widths={[800, 1440]} sizes="(max-width: 1240px) 100vw, 1000px" />
        <img class="phone" src={d.coverMobile} alt={`${d.title}: mobile, 390 wide`} width="390" height="844" loading="lazy" />
        <figcaption><b>Frames</b>Desktop 1440 · mobile 390</figcaption>
      </figure>
    )}

    {d.metrics.length > 0 && (
      <section class="results" aria-labelledby="results-h">
        <h2 id="results-h" class="eyebrow">Results</h2>
        <div class="snap">{d.metrics.map((m) => <div><span>{m.label}</span><b>{m.value}</b><small class="mono muted">{m.source} · {m.date}</small></div>)}</div>
      </section>
    )}

    {d.structure && (
      <figure class="fig" style="margin:24px 0 48px">
        <div class="canvas">
          <div class="flow">
            {d.structure.map((s, i) => (
              <>
                {i > 0 && <span class="ar">·</span>}
                <div class={`st ${i === 0 ? 'acc' : ''}`}><span class="k">Collection</span><b>{s.name}</b><span>{s.detail}</span></div>
              </>
            ))}
          </div>
        </div>
        <figcaption><b>{d.structureTitle ?? 'Structure'}</b>{d.structureNote ?? 'Each collection has its own template, so new content never needs new design.'}</figcaption>
      </figure>
    )}

    <article class="prose"><Content /></article>

    {d.howIWorked.length > 0 && (
      <section class="prose how" aria-labelledby="how-h">
        <h2 id="how-h">How I worked</h2>
        <ul>{d.howIWorked.map((b) => <li>{b}</li>)}</ul>
      </section>
    )}

    {d.url && <p style="margin-bottom:48px"><a class="btn" href={d.url} target="_blank" rel="noopener">Visit live site ↗</a></p>}

    <section class="case-cta" aria-labelledby="cta-h">
      <h2 id="cta-h">Need a site like this?</h2>
      <p>Send a few lines: what you're building, a link to your current site, and when you need it live.</p>
      <div class="row">
        <a class="btn primary" href={`mailto:${EMAIL}?subject=${encodeURIComponent(`Website project (from the ${d.eyebrow.split(' · ')[0]} case study)`)}`} data-track="contact_click" data-track-method="email" data-track-location={`case_study_${entry.id}`}>Email me <span class="ar">→</span></a>
        {PHONE && <a class="btn" href={`tel:${PHONE_TEL}`} data-track="contact_click" data-track-method="phone" data-track-location={`case_study_${entry.id}`}>Call {PHONE}</a>}
      </div>
    </section>

    <div class="next">
      <span class="eyebrow">Next website</span>
      <a href={`/work/${next.id}/`}><span class="eyebrow">{next.data.eyebrow}</span><b>{next.data.title} →</b></a>
    </div>
  </div>
</Base>
